<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_tllr_fc_control_calidad_list" model="ir.ui.view">
            <field name="name">tllr_fc.control_calidad.list</field>
            <field name="model">tllr_fc.control_calidad</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'aprobado'"
                      decoration-danger="state == 'rechazado'">
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="ot_id"/>
                    <field name="vehiculo_id"/>
                    <field name="partner_id" optional="hide"/>
                    <field name="responsable_id"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'aprobado'"
                           decoration-danger="state == 'rechazado'"
                           decoration-info="state == 'borrador'"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_tllr_fc_control_calidad_form" model="ir.ui.view">
            <field name="name">tllr_fc.control_calidad.form</field>
            <field name="model">tllr_fc.control_calidad</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_aprobar_todas" string="Aprobar todas" type="object"
                                invisible="state != 'borrador'"/>
                        <button name="action_confirmar" string="Confirmar control" type="object"
                                class="btn-primary" invisible="state != 'borrador'"
                                groups="tllr_fc.group_supervisor"/>
                        <field name="state" widget="statusbar" statusbar_visible="borrador,aprobado"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Rechazado" bg_color="text-bg-danger"
                                invisible="state != 'rechazado'"/>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="ot_id" readonly="id"
                                       domain="[('state', '=', 'calidad')]"
                                       options="{'no_create': True}"/>
                                <field name="vehiculo_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="fecha" readonly="state != 'borrador'"/>
                                <field name="responsable_id" readonly="state != 'borrador'"
                                       options="{'no_create': True}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="linea_ids" readonly="state != 'borrador'">
                            <list editable="bottom" create="0" delete="0"
                                  decoration-success="resultado == 'aprobado'"
                                  decoration-danger="resultado == 'rechazado'">
                                <field name="ot_servicio_id" readonly="1" force_save="1"/>
                                <field name="informe" optional="show"/>
                                <field name="resultado_texto"/>
                                <field name="resultado"/>
                            </list>
                            <form>
                                <group>
                                    <field name="ot_servicio_id" readonly="1" force_save="1"/>
                                    <field name="informe"/>
                                    <field name="resultado"/>
                                    <field name="resultado_texto"/>
                                </group>
                                <field name="check_ids">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="name" readonly="1"/>
                                        <field name="cumple"/>
                                    </list>
                                </field>
                            </form>
                        </field>
                        <group>
                            <field name="comentarios" readonly="state != 'borrador'"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_control_calidad_search" model="ir.ui.view">
            <field name="name">tllr_fc.control_calidad.search</field>
            <field name="model">tllr_fc.control_calidad</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="ot_id"/>
                    <field name="vehiculo_id"/>
                    <field name="responsable_id"/>
                    <filter string="Borrador" name="borrador" domain="[('state', '=', 'borrador')]"/>
                    <filter string="Aprobados" name="aprobado" domain="[('state', '=', 'aprobado')]"/>
                    <filter string="Rechazados" name="rechazado" domain="[('state', '=', 'rechazado')]"/>
                    <group>
                        <filter string="Estado" name="agrupar_estado" context="{'group_by': 'state'}"/>
                        <filter string="Responsable" name="agrupar_responsable"
                                context="{'group_by': 'responsable_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_tllr_fc_control_calidad" model="ir.actions.act_window">
            <field name="name">Controles de calidad</field>
            <field name="res_model">tllr_fc.control_calidad</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_tllr_fc_control_calidad_search"/>
            <field name="context">{'search_default_borrador': 1}</field>
        </record>

    </data>
</odoo>
