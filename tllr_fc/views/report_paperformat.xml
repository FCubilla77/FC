<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Formato de papel estándar de los informes del taller:
             A4 vertical; márgenes superior 15 mm, inferior 15 mm, derecho 15 mm, izquierdo 20 mm -->
        <record id="paperformat_a4" model="report.paperformat">
            <field name="name">Taller - A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">15</field>
            <field name="margin_right">15</field>
            <field name="margin_left">20</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>
