<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_tllr_fc_wizard_excepcion_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.excepcion.form</field>
            <field name="model">tllr_fc.wizard.excepcion</field>
            <field name="arch" type="xml">
                <form>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="accion" invisible="1"/>
                    <field name="grupo_requerido" invisible="1"/>
                    <div class="alert alert-warning" role="alert">
                        Esta acción requiere la autorización de un
                        <strong>supervisor de taller</strong>. Debe estar iniciada la sesión
                        con un usuario que tenga ese rol.
                    </div>
                    <group>
                        <field name="descripcion" force_save="1"/>
                        <field name="motivo" placeholder="Explicá por qué se autoriza la excepción"/>
                    </group>
                    <footer>
                        <button name="action_autorizar" string="Autorizar" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_confirmar_advertencia_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.confirmar_advertencia.form</field>
            <field name="model">tllr_fc.wizard.confirmar_advertencia</field>
            <field name="arch" type="xml">
                <form>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="accion" invisible="1"/>
                    <div class="alert alert-warning" role="alert">
                        <field name="mensaje" nolabel="1" force_save="1"/>
                    </div>
                    <p>¿Querés continuar de todos modos?</p>
                    <footer>
                        <button name="action_continuar" string="Continuar" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_detener_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.detener.form</field>
            <field name="model">tllr_fc.wizard.detener</field>
            <field name="arch" type="xml">
                <form>
                    <field name="ot_id" invisible="1"/>
                    <group>
                        <field name="motivo_id" options="{'no_create': True}"/>
                        <field name="fecha_estimada"/>
                    </group>
                    <footer>
                        <button name="action_detener" string="Detener OT" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_aprobacion_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.aprobacion.form</field>
            <field name="model">tllr_fc.wizard.aprobacion</field>
            <field name="arch" type="xml">
                <form>
                    <field name="ot_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="estado"/>
                            <field name="persona" placeholder="Quién respondió por el cliente"/>
                        </group>
                        <group>
                            <field name="medio"/>
                            <field name="fecha"/>
                        </group>
                    </group>
                    <group string="Servicios adicionales">
                        <field name="servicio_ids" nolabel="1" colspan="2"
                               domain="[('ot_id', '=', ot_id), ('pendiente_aprobacion', '=', True)]">
                            <list><field name="product_id"/><field name="cantidad"/><field name="cantidad_excedente"/><field name="subtotal"/></list>
                        </field>
                    </group>
                    <group string="Repuestos, insumos y accesorios adicionales">
                        <field name="producto_ids" nolabel="1" colspan="2"
                               domain="[('ot_id', '=', ot_id), ('pendiente_aprobacion', '=', True)]">
                            <list><field name="product_id"/><field name="cantidad_reservada"/><field name="cantidad_excedente"/><field name="subtotal"/></list>
                        </field>
                    </group>
                    <group><field name="notas"/></group>
                    <div class="alert alert-warning" role="alert" invisible="estado != 'rechazado'">
                        Si el cliente rechaza, las líneas nuevas se quitan de la OT y los excedentes de cantidad vuelven a lo cubierto (queda constancia en el historial).
                    </div>
                    <footer>
                        <button name="action_registrar" string="Registrar" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_cancelar_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.cancelar.form</field>
            <field name="model">tllr_fc.wizard.cancelar</field>
            <field name="arch" type="xml">
                <form>
                    <field name="trabajo_realizado" invisible="1"/>
                    <field name="puede_liquidar" invisible="1"/>
                    <group>
                        <field name="ot_id"/>
                        <field name="motivo_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="liquidar" invisible="not puede_liquidar"/>
                    </group>
                    <field name="vista_previa" readonly="1"/>
                    <group>
                        <field name="confirmo"/>
                    </group>
                    <footer>
                        <button name="action_confirmar" string="Cancelar la OT" type="object"
                                class="btn-danger" data-hotkey="q"/>
                        <button string="Volver" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_entrega_cancelada_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.entrega_cancelada.form</field>
            <field name="model">tllr_fc.wizard.entrega_cancelada</field>
            <field name="arch" type="xml">
                <form>
                    <field name="ot_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        La OT fue cancelada. ¿Desea entregar el vehículo al cliente? Con «Sí» se
                        habilita el botón Entregar de la OT; con «No», la entrega queda sin habilitar
                        (un supervisor puede habilitarla después).
                    </div>
                    <footer>
                        <button name="action_si" string="Sí, entregar el vehículo" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button name="action_no" string="No" type="object"
                                class="btn-secondary" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_reclamo_garantia_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.reclamo_garantia.form</field>
            <field name="model">tllr_fc.wizard.reclamo_garantia</field>
            <field name="arch" type="xml">
                <form>
                    <div class="alert alert-warning" role="alert" invisible="not aviso">
                        <field name="aviso" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="ot_id"/>
                        <field name="garantia_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="kilometraje_actual"/>
                        <field name="descripcion" placeholder="Qué problema presenta el vehículo"/>
                    </group>
                    <footer>
                        <button name="action_reclamar" string="Generar recepción de garantía"
                                type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="view_tllr_fc_wizard_refacturar_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.refacturar.form</field>
            <field name="model">tllr_fc.wizard.refacturar</field>
            <field name="arch" type="xml">
                <form>
                    <field name="ot_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        La factura anterior fue anulada con una nota de crédito total. Dejá tildado
                        lo que se factura; lo que destildes queda con «No facturar» (conserva su
                        costo en la OT).
                    </div>
                    <group><field name="motivo"/></group>
                    <field name="linea_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="name"/>
                            <field name="cantidad"/>
                            <field name="importe"/>
                            <field name="facturar"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_refacturar" string="Refacturar" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_wizard_devolver_consumo_form" model="ir.ui.view">
            <field name="name">tllr_fc.wizard.devolver_consumo.form</field>
            <field name="model">tllr_fc.wizard.devolver_consumo</field>
            <field name="arch" type="xml">
                <form>
                    <field name="producto_id" invisible="1"/>
                    <group>
                        <field name="consumido"/>
                        <field name="cantidad"/>
                        <field name="motivo"/>
                    </group>
                    <footer>
                        <button name="action_devolver" string="Devolver a stock" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
