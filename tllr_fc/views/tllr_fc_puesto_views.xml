<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_tllr_fc_puesto_list" model="ir.ui.view">
            <field name="name">tllr_fc.puesto.list</field>
            <field name="model">tllr_fc.puesto</field>
            <field name="arch" type="xml">
                <list>
                    <field name="codigo"/>
                    <field name="name"/>
                    <field name="servicio_ids" widget="many2many_tags"/>
                    <field name="almacen_id"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_tllr_fc_puesto_form" model="ir.ui.view">
            <field name="name">tllr_fc.puesto.form</field>
            <field name="model">tllr_fc.puesto</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                                invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Ej.: Bahía 1"/>
                            </h1>
                            <h3>
                                <field name="codigo"/>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="almacen_id"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Tipos de trabajo que se realizan en el puesto">
                            <field name="servicio_ids" nolabel="1" colspan="2" widget="many2many_tags"
                                   required="1" domain="[('type', '=', 'service')]"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_puesto_search" model="ir.ui.view">
            <field name="name">tllr_fc.puesto.search</field>
            <field name="model">tllr_fc.puesto</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="codigo"/>
                    <field name="servicio_ids"/>
                    <field name="almacen_id"/>
                    <filter string="Archivados" name="inactivos" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_tllr_fc_puesto" model="ir.actions.act_window">
            <field name="name">Puestos de trabajo</field>
            <field name="res_model">tllr_fc.puesto</field>
            <field name="domain">[('es_calidad', '=', False)]</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
