<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_tllr_fc" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.tllr_fc</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Taller" string="Taller" name="tllr_fc"
                         groups="tllr_fc.group_administrador">
                        <field name="company_id" invisible="1"/>

                        <block title="Integraciones" name="tllr_fc_integraciones">
                            <setting string="Integración con Ventas" groups="base.group_system"
                                     help="Presupuesto, pedido de venta y factura desde el pedido para las OT de Cliente.">
                                <field name="module_tllr_fc_sale"/>
                                <div class="alert alert-warning mt-2" role="alert">
                                    Al activar y guardar se instala el módulo puente «Integración con Ventas» y, si no está instalado, también Ventas. Al desactivar y guardar se desinstala el puente y se eliminan sus datos: vínculos de presupuestos con las OT y las recepciones, y los campos del puente. Los presupuestos y pedidos de Ventas no se borran.
                                </div>
                            </setting>
                            <setting string="Integración con Ventas" groups="!base.group_system"
                                     help="Solo un administrador de Odoo puede instalar o desinstalar esta integración.">
                                <field name="module_tllr_fc_sale" readonly="1"/>
                                <div class="alert alert-warning mt-2" role="alert">
                                    Solo un administrador de Odoo puede cambiar esta opción. Al activarla se instala el puente con Ventas (e instala Ventas si falta); al desactivarla se desinstala y se eliminan sus datos.
                                </div>
                            </setting>
                            <setting string="Integración con Compras" groups="base.group_system"
                                     help="Compra directa de repuestos y servicios tercerizados desde la OT.">
                                <field name="module_tllr_fc_purchase"/>
                                <div class="alert alert-warning mt-2" role="alert">
                                    Al activar y guardar se instala el módulo puente «Integración con Compras» y, si no están instalados, también Compras y su integración con Inventario. Al desactivar y guardar se desinstala el puente y se eliminan sus datos: vínculos de compras con las OT, servicios tercerizados y costos reales asociados. Las órdenes de compra de Compras no se borran.
                                </div>
                            </setting>
                            <setting string="Integración con Compras" groups="!base.group_system"
                                     help="Solo un administrador de Odoo puede instalar o desinstalar esta integración.">
                                <field name="module_tllr_fc_purchase" readonly="1"/>
                                <div class="alert alert-warning mt-2" role="alert">
                                    Solo un administrador de Odoo puede cambiar esta opción. Al activarla se instala el puente con Compras (e instala Compras si falta); al desactivarla se desinstala y se eliminan sus datos.
                                </div>
                            </setting>
                        </block>

                        <block title="Control de calidad" name="tllr_fc_calidad">
                            <setting string="Control de calidad en OT de Cliente"
                                     help="Si está activo, las OT de tipo Cliente pasan por control de calidad antes de quedar listas.">
                                <field name="tllr_fc_qc_cliente"/>
                            </setting>
                            <setting string="Control de calidad en OT Interna"
                                     help="Si está activo, las OT de tipo Interno pasan por control de calidad.">
                                <field name="tllr_fc_qc_interno"/>
                            </setting>
                            <setting string="Control de calidad en OT de Garantía"
                                     help="Si está activo, las OT de tipo Garantía pasan por control de calidad.">
                                <field name="tllr_fc_qc_garantia"/>
                            </setting>
                        </block>

                        <block title="Trabajos adicionales" name="tllr_fc_adicionales">
                            <setting string="Aprobación de trabajos adicionales"
                                     help="Define si la aprobación del cliente es obligatoria para ejecutar un adicional (solo OT de Cliente).">
                                <field name="tllr_fc_aprobacion_adicional"/>
                            </setting>
                        </block>

                        <block title="Traslados de stock" name="tllr_fc_traslados">
                            <setting string="Almacén principal de repuestos e insumos"
                                     help="Los repuestos e insumos de cada puesto de la OT se trasladan desde este almacén al almacén del puesto mediante un traslado interno en borrador, que confirma el encargado de almacén. Al terminar el puesto o cancelar la OT se genera la devolución. Vacío = sin traslados.">
                                <field name="tllr_fc_almacen_principal_id"
                                       domain="[('company_id', '=', company_id)]"/>
                            </setting>
                        </block>

                        <block title="Facturación" name="tllr_fc_facturacion">
                            <setting string="Diario de factura de venta"
                                     help="Diario de venta usado en las facturas generadas desde la OT. Es obligatorio para ejecutar 'Cerrar para facturar'.">
                                <field name="tllr_fc_diario_venta_id"
                                       domain="[('type', '=', 'sale'), ('company_id', '=', company_id)]"/>
                            </setting>
                        </block>

                        <block title="Asientos contables" name="tllr_fc_asientos">
                            <setting string="Generar asientos contables del taller"
                                     help="Activa los asientos propios del taller: costo de los repuestos e insumos no facturados, OT internas, garantías, cancelaciones y ajustes de costo. El costo de lo facturado lo genera la factura (asiento estándar de Odoo). Con el ajuste desactivado solo se usan los movimientos estándar de Inventario y Facturación.">
                                <field name="tllr_fc_generar_asientos"/>
                                <div class="content-group mt16" invisible="not tllr_fc_generar_asientos">
                                    <div class="row mt8">
                                        <label for="tllr_fc_diario_id" class="col-lg-4 o_light_label"/>
                                        <field name="tllr_fc_diario_id" required="tllr_fc_generar_asientos"
                                               domain="[('type', '=', 'general'), ('company_id', '=', company_id)]"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="tllr_fc_cuenta_gasto_interna_id" class="col-lg-4 o_light_label"/>
                                        <field name="tllr_fc_cuenta_gasto_interna_id" required="tllr_fc_generar_asientos"
                                               domain="[('company_ids', 'in', [company_id])]"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="tllr_fc_cuenta_gasto_garantia_id" class="col-lg-4 o_light_label"/>
                                        <field name="tllr_fc_cuenta_gasto_garantia_id" required="tllr_fc_generar_asientos"
                                               domain="[('company_ids', 'in', [company_id])]"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="tllr_fc_cuenta_perdida_id" class="col-lg-4 o_light_label"/>
                                        <field name="tllr_fc_cuenta_perdida_id" required="tllr_fc_generar_asientos"
                                               domain="[('company_ids', 'in', [company_id])]"/>
                                    </div>
                                </div>
                            </setting>
                            <setting string="Generar asiento por horas del personal"
                                     help="Contabiliza el costo de las horas del personal (horas × costo/hora de la función): OT de cliente al confirmar la factura; OT internas y garantías al entregar. Desactivado, el costo de la mano de obra solo se ve en la rentabilidad de la OT. Requiere asientos contables activos."
                                     invisible="not tllr_fc_generar_asientos">
                                <field name="tllr_fc_asiento_horas"/>
                                <div class="content-group mt16" invisible="not tllr_fc_asiento_horas">
                                    <div class="row mt8">
                                        <label for="tllr_fc_cuenta_mano_obra_id" class="col-lg-4 o_light_label"/>
                                        <field name="tllr_fc_cuenta_mano_obra_id" required="tllr_fc_asiento_horas"
                                               domain="[('company_ids', 'in', [company_id])]"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="tllr_fc_cuenta_costo_ventas_id" class="col-lg-4 o_light_label"/>
                                        <field name="tllr_fc_cuenta_costo_ventas_id" required="tllr_fc_asiento_horas"
                                               domain="[('company_ids', 'in', [company_id])]"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_tllr_fc_config_settings" model="ir.actions.act_window">
            <field name="name">Ajustes</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module': 'tllr_fc', 'bin_size': False}</field>
        </record>

    </data>
</odoo>
