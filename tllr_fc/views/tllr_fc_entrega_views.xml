<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_tllr_fc_entrega_list" model="ir.ui.view">
            <field name="name">tllr_fc.entrega.list</field>
            <field name="model">tllr_fc.entrega</field>
            <field name="arch" type="xml">
                <list create="0" decoration-muted="state == 'borrador'">
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="ot_id"/>
                    <field name="vehiculo_id"/>
                    <field name="partner_id"/>
                    <field name="retira_id"/>
                    <field name="state" widget="badge" decoration-success="state == 'confirmada'"/>
                </list>
            </field>
        </record>

        <record id="view_tllr_fc_entrega_form" model="ir.ui.view">
            <field name="name">tllr_fc.entrega.form</field>
            <field name="model">tllr_fc.entrega</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirmar" string="Confirmar entrega" type="object"
                                class="btn-primary" invisible="state != 'borrador'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="hay_diferencias" invisible="1"/>
                        <field name="ot_tipo" invisible="1"/>
                        <div class="alert alert-warning" role="alert"
                             invisible="not hay_diferencias or state != 'borrador'">
                            Hay diferencias de inventario: confirmar la entrega requiere la
                            autorización de un supervisor.
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not alerta_combustible">
                            <field name="alerta_combustible" readonly="1" nolabel="1"/>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="ot_id" readonly="state != 'borrador'"
                                       options="{'no_create': True}"
                                       domain="['|', ('state', '=', 'listo'), '&amp;', ('state', '=', 'cancelada'), ('entrega_habilitada', '=', True)]"/>
                                <field name="vehiculo_id"/>
                                <field name="partner_id"/>
                                <field name="retira_id" readonly="state != 'borrador'"
                                       required="state == 'borrador'"/>
                                <field name="fecha" readonly="state != 'borrador'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="kilometraje_ingreso"/>
                                <field name="kilometraje_salida" readonly="state != 'borrador'"/>
                                <field name="combustible_ingreso"/>
                                <field name="combustible_salida" readonly="state != 'borrador'"
                                       required="state == 'borrador'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Revisión de inventario" name="revision">
                                <field name="linea_ids" readonly="state != 'borrador'">
                                    <list editable="bottom" create="0" delete="0"
                                          decoration-danger="diferencia">
                                        <field name="origen" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="presente_recepcion" column_invisible="1"/>
                                        <field name="entregado"/>
                                        <field name="observacion"/>
                                        <field name="diferencia" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Comentarios" name="comentarios">
                                <field name="comentarios" readonly="state != 'borrador'"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_entrega_search" model="ir.ui.view">
            <field name="name">tllr_fc.entrega.search</field>
            <field name="model">tllr_fc.entrega</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="ot_id"/>
                    <field name="vehiculo_id"/>
                    <field name="partner_id"/>
                    <filter string="Borrador" name="borrador" domain="[('state', '=', 'borrador')]"/>
                    <filter string="Confirmadas" name="confirmada" domain="[('state', '=', 'confirmada')]"/>
                    <group>
                        <filter string="Cliente" name="agrupar_cliente" context="{'group_by': 'partner_id'}"/>
                        <filter string="Estado" name="agrupar_estado" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_tllr_fc_entrega" model="ir.actions.act_window">
            <field name="name">Entregas</field>
            <field name="res_model">tllr_fc.entrega</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Garantías -->
        <record id="view_tllr_fc_garantia_list" model="ir.ui.view">
            <field name="name">tllr_fc.garantia.list</field>
            <field name="model">tllr_fc.garantia</field>
            <field name="arch" type="xml">
                <list decoration-danger="state in ('vencida_fecha', 'vencida_km')" decoration-success="state == 'vigente'" decoration-warning="state == 'en_reclamo'" decoration-muted="state == 'ejecutada'">
                    <field name="ot_id"/>
                    <field name="vehiculo_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="fecha_entrega"/>
                    <field name="fecha_limite"/>
                    <field name="km_limite"/>
                    <field name="state" widget="badge"/>
                    <field name="reclamo_ot_id"/>
                </list>
            </field>
        </record>

        <record id="view_tllr_fc_garantia_form" model="ir.ui.view">
            <field name="name">tllr_fc.garantia.form</field>
            <field name="model">tllr_fc.garantia</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="ot_id" readonly="id" options="{'no_create': True}"
                                       domain="[('tipo', '=', 'cliente'), ('state', 'in', ('entregado', 'cancelada'))]"/>
                                <field name="vehiculo_id"/>
                                <field name="partner_id"/>
                                <field name="product_id" readonly="id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="fecha_entrega"/>
                                <field name="dias"/>
                                <field name="fecha_limite"/>
                                <field name="km"/>
                                <field name="km_limite"/>
                                <field name="state"/>
                                <field name="reclamo_recepcion_id"/>
                                <field name="reclamo_ot_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_tllr_fc_garantia_search" model="ir.ui.view">
            <field name="name">tllr_fc.garantia.search</field>
            <field name="model">tllr_fc.garantia</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ot_id"/>
                    <field name="vehiculo_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <filter string="Vigentes por fecha" name="vigente"
                            domain="[('fecha_limite', '&gt;=', context_today().strftime('%Y-%m-%d')), ('reclamo_ot_id', '=', False), ('reclamo_recepcion_id', '=', False)]"/>
                    <filter string="Vencidas por fecha" name="vencida"
                            domain="[('fecha_limite', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="Reclamadas" name="reclamada" domain="[('reclamo_ot_id', '!=', False)]"/>
                    <group>
                        <filter string="Cliente" name="agrupar_cliente" context="{'group_by': 'partner_id'}"/>
                        <filter string="Vehículo" name="agrupar_vehiculo" context="{'group_by': 'vehiculo_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_tllr_fc_garantia" model="ir.actions.act_window">
            <field name="name">Garantías</field>
            <field name="res_model">tllr_fc.garantia</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_vigente': 1}</field>
        </record>

        <!-- Reclamo desde el listado de garantías (menú Acción) -->
        <record id="action_tllr_fc_reclamo_desde_garantia" model="ir.actions.act_window">
            <field name="name">Reclamo de garantía</field>
            <field name="res_model">tllr_fc.wizard.reclamo_garantia</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_tllr_fc_garantia"/>
            <field name="binding_view_types">list</field>
        </record>

        <!-- Comprobante de entrega -->
        <record id="action_report_entrega" model="ir.actions.report">
            <field name="name">Comprobante de entrega</field>
            <field name="model">tllr_fc.entrega</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">tllr_fc.report_entrega_document</field>
            <field name="report_file">tllr_fc.report_entrega_document</field>
            <field name="print_report_name">'Entrega-%s' % (object.name or '').replace('/', '-')</field>
            <field name="paperformat_id" ref="tllr_fc.paperformat_a4"/>
            <field name="binding_model_id" ref="model_tllr_fc_entrega"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_entrega_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="tllr_fc.report_layout">
                        <div class="page">
                            <div class="row">
                                <div class="col-8">
                                    <h2 style="margin-bottom: 0;">Comprobante de entrega</h2>
                                    <h4 style="margin-top: 4px;"><span t-field="o.name"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <strong t-field="o.company_id.name"/><br/>
                                    <span t-if="o.company_id.vat">RUC: <span t-field="o.company_id.vat"/><br/></span>
                                    <span t-field="o.fecha" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/>
                                </div>
                            </div>
                            <hr/>
                            <div t-if="o.ot_id.state == 'cancelada'" class="alert alert-warning">
                                <strong>OT cancelada</strong>
                                <span t-if="o.ot_id.liquidada"> con liquidación de lo realizado.</span>
                                <span t-else=""> sin liquidación.</span>
                            </div>
                            <div class="row" style="margin-bottom: 12px;">
                                <div class="col-6">
                                    <h5>Cliente</h5>
                                    <div><strong t-field="o.partner_id.name"/></div>
                                    <div>Retira: <span t-field="o.retira_id.name"/></div>
                                    <div>OT: <span t-field="o.ot_id.name"/></div>
                                </div>
                                <div class="col-6">
                                    <h5>Vehículo</h5>
                                    <div><strong>Chapa: <span t-field="o.vehiculo_id.chapa"/></strong></div>
                                    <div>
                                        <span t-field="o.vehiculo_id.marca_id.name"/>
                                        <span t-field="o.vehiculo_id.modelo_id.name"/>
                                    </div>
                                    <div>Km ingreso: <span t-out="'{:,}'.format(o.kilometraje_ingreso).replace(',', '.')"/></div>
                                    <div>Km salida: <span t-out="'{:,}'.format(o.kilometraje_salida).replace(',', '.')"/></div>
                                    <div t-if="o.combustible_ingreso or o.combustible_salida">
                                        Combustible: ingreso <span t-field="o.combustible_ingreso"/>
                                        · salida <span t-field="o.combustible_salida"/>
                                    </div>
                                </div>
                            </div>
                            <div t-if="o.alerta_combustible" class="alert alert-warning">
                                <span t-field="o.alerta_combustible"/>
                            </div>

                            <h5>Revisión de inventario</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="vertical-align: middle;">Descripción</th>
                                        <th rowspan="2" style="width: 16%; vertical-align: middle;">Origen</th>
                                        <th colspan="2" class="text-center">Cómo se recibió</th>
                                        <th colspan="2" class="text-center">Cómo se entrega</th>
                                    </tr>
                                    <tr>
                                        <th style="width: 9%;">Presente</th>
                                        <th style="width: 17%;">Observación</th>
                                        <th style="width: 10%;">Entregado</th>
                                        <th style="width: 17%;">Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.linea_ids" t-as="l">
                                        <td><span t-field="l.name"/></td>
                                        <td><span t-field="l.origen"/></td>
                                        <td><span t-out="'Sí' if l.presente_recepcion else 'No'"/></td>
                                        <td><span t-field="l.observacion_recepcion"/></td>
                                        <td><span t-out="'Sí' if l.entregado == 'si' else 'No'"/></td>
                                        <td><span t-field="l.observacion"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <t t-set="control" t-value="o.ot_id.sudo().control_ids.filtered(lambda c: c.state != 'borrador').sorted(lambda c: (c.fecha, c.id))[-1:]"/>
                            <div t-if="control" style="margin-bottom: 12px;">
                                <h5>Control de calidad</h5>
                                <div>
                                    <strong t-field="control.name"/> ·
                                    <span t-field="control.fecha" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/>
                                    · Responsable: <span t-field="control.responsable_id.name"/>
                                    · <span t-field="control.state"/>
                                </div>
                                <table class="table table-sm" t-if="control.linea_ids">
                                    <thead>
                                        <tr>
                                            <th>Servicio</th>
                                            <th style="width: 14%;">Resultado</th>
                                            <th>Observaciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="control.linea_ids" t-as="l">
                                            <td><span t-field="l.ot_servicio_id.product_id.display_name"/></td>
                                            <td><span t-field="l.resultado"/></td>
                                            <td style="white-space: pre-wrap;"><span t-field="l.resultado_texto"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <t t-set="ot_informe" t-value="o.ot_id.sudo()"/>
                            <t t-call="tllr_fc.report_informe_servicios">
                                <t t-set="o" t-value="ot_informe"/>
                            </t>

                            <t t-set="garantias" t-value="o.ot_id.sudo().garantia_ids"/>
                            <div t-if="garantias" style="margin-bottom: 12px;">
                                <h5>Garantías otorgadas</h5>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Servicio / producto</th>
                                            <th style="width: 12%;">Días</th>
                                            <th style="width: 18%;">Vence el</th>
                                            <th style="width: 14%;">Km de garantía</th>
                                            <th style="width: 18%;">Hasta los (km)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="garantias" t-as="g">
                                            <td><span t-field="g.product_id.display_name"/></td>
                                            <td class="text-end"><span t-out="g.dias"/></td>
                                            <td class="text-center"><span t-field="g.fecha_limite" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                                            <td class="text-end"><span t-out="'{:,}'.format(g.km).replace(',', '.') if g.km else '—'"/></td>
                                            <td class="text-end"><span t-out="'{:,}'.format(g.km_limite).replace(',', '.') if g.km_limite else '—'"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="text-muted">
                                    La garantía vence al cumplirse el plazo en días o el kilometraje, lo que ocurra primero.
                                </div>
                            </div>

                            <div t-if="o.comentarios" style="margin-bottom: 12px;">
                                <h5>Comentarios</h5>
                                <div style="white-space: pre-wrap;"><span t-field="o.comentarios"/></div>
                            </div>

                            <div class="row" style="margin-top: 70px;">
                                <div class="col-6 text-center">
                                    <div style="border-top: 1px solid #000; margin: 0 20px; padding-top: 4px;">
                                        Firma del cliente
                                    </div>
                                    <div>Aclaración: ____________________</div>
                                </div>
                                <div class="col-6 text-center">
                                    <div style="border-top: 1px solid #000; margin: 0 20px; padding-top: 4px;">
                                        Taller
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
