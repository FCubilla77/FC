<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_fe_py_recepcion_purchase" model="ir.ui.view">
        <field name="name">res.partner.form.fe_py_recepcion_purchase</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="fe_py_recepcion.view_partner_form_fe_py_recepcion"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fe_py_recepcion_confirmar_auto']" position="after">
                <field name="fe_py_recepcion_confirmar_sin_cotizacion"
                       invisible="not fe_py_recepcion_confirmar_auto"
                       groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
