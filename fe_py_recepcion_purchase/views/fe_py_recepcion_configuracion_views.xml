        <field name="model">fe_py_recepcion.configuracion</field>
        <field name="inherit_id" ref="fe_py_recepcion.view_fe_py_recepcion_configuracion_list"/>
        <field name="arch" type="xml">
            <field name="diario_id" position="after">
                <field name="vincular_compras"/>
            </field>
        </field>
    </record>
</odoo>
