<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_tllr_fc_sale" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.tllr_fc_sale</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="tllr_fc.res_config_settings_view_form_tllr_fc"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='tllr_fc_facturacion']" position="before">
                    <block title="Integración con Ventas" name="tllr_fc_ventas">
                        <setting string="Integración con Ventas"
                                 help="Activo: la OT de cliente usa un presupuesto/pedido de venta y se factura desde el pedido. Desactivado: se factura directo desde Contabilidad. Las OT que ya tienen presupuesto siguen facturándose desde su pedido.">
                            <field name="tllr_fc_usar_ventas"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
