<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tllr_fc_ot_form_sale" model="ir.ui.view">
            <field name="name">tllr_fc.ot.form.sale</field>
            <field name="model">tllr_fc.ot</field>
            <field name="inherit_id" ref="tllr_fc.view_tllr_fc_ot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_iniciar']" position="after">
                    <button name="action_actualizar_presupuesto" type="object"
                            string="Crear / actualizar presupuesto"
                            groups="tllr_fc.group_supervisor"
                            invisible="not tllr_fc_usar_ventas or tipo == 'interno' or cerrada_facturar or state in ('entregado', 'cancelada') or (sale_order_id and not actualizar_presupuesto)"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_ver_presupuesto" type="object"
                            class="oe_stat_button" icon="fa-file-text"
                            invisible="not sale_order_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Presupuesto</span>
                            <field name="presupuesto_estado" readonly="1"/>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='recepcion_id']" position="after">
                    <field name="tllr_fc_usar_ventas" invisible="1"/>
                    <field name="sale_order_id"
                           invisible="not sale_order_id and not tllr_fc_usar_ventas"/>
                    <field name="presupuesto_importe" invisible="not sale_order_id"/>
                    <field name="actualizar_presupuesto" groups="tllr_fc.group_supervisor"
                           invisible="not tllr_fc_usar_ventas or tipo == 'interno'"
                           readonly="cerrada_facturar"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
