<odoo>
    <data>
        <record id="view_local_py_cheque_cliente_form" model="ir.ui.view">
            <field name="name">local_py.cheque_cliente.form</field>
            <field name="model">local_py.cheque_cliente</field>
            <field name="arch" type="xml">
                <form string="Cheque de Cliente">
                    <header>
                        <button name="action_abrir_wizard_rechazar" type="object" string="Rechazar"
                                class="btn-primary" invisible="estado != 'en_cartera'"/>
                        <button name="action_deshacer_rechazo" type="object" string="Deshacer Rechazo"
                                class="btn-secondary" invisible="estado != 'rechazado'"/>
                        <field name="estado" widget="statusbar"
                               statusbar_visible="en_cartera,rechazado,depositado,negociado,canjeado"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" options="{'no_create': True}"/>
                                <field name="bank_id" options="{'no_create': True}"/>
                                <field name="tipo"/>
                                <field name="fecha_emision"/>
                                <field name="fecha_vencimiento"/>
                            </group>
                            <group>
                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                                <field name="currency_id" options="{'no_create': True}"/>
                                <field name="importe"/>
                                <field name="recibo_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Rechazo" invisible="estado not in ('rechazado',)">
                            <field name="fecha_rechazo" readonly="1"/>
                            <field name="motivo_rechazo" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_local_py_cheque_cliente_list" model="ir.ui.view">
            <field name="name">local_py.cheque_cliente.list</field>
            <field name="model">local_py.cheque_cliente</field>
            <field name="arch" type="xml">
                <list string="Cheques de Clientes" decoration-danger="estado == 'rechazado'" decoration-muted="estado == 'anulado'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="bank_id"/>
                    <field name="tipo"/>
                    <field name="fecha_emision"/>
                    <field name="fecha_vencimiento"/>
                    <field name="importe"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="estado"/>
                    <field name="recibo_id"/>
                </list>
            </field>
        </record>

        <record id="view_local_py_cheque_cliente_search" model="ir.ui.view">
            <field name="name">local_py.cheque_cliente.search</field>
            <field name="model">local_py.cheque_cliente</field>
            <field name="arch" type="xml">
                <search string="Cheques de Clientes">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="bank_id"/>
                    <filter string="En Cartera" name="filter_en_cartera" domain="[('estado', '=', 'en_cartera')]"/>
                    <filter string="Rechazados" name="filter_rechazado" domain="[('estado', '=', 'rechazado')]"/>
                    <separator/>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_local_py_cheque_cliente" model="ir.actions.act_window">
            <field name="name">Cheques de Clientes</field>
            <field name="res_model">local_py.cheque_cliente</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_en_cartera': 1}</field>
        </record>

        <menuitem id="menu_local_py_cheque_cliente"
                  name="Cheques de Clientes"
                  parent="account.menu_finance_receivables"
                  action="action_local_py_cheque_cliente"
                  groups="account.group_account_manager"
                  sequence="16"/>

        <record id="view_local_py_cheque_cliente_rechazar_wizard_form" model="ir.ui.view">
            <field name="name">local_py.cheque_cliente.rechazar_wizard.form</field>
            <field name="model">local_py.cheque_cliente.rechazar_wizard</field>
            <field name="arch" type="xml">
                <form string="Rechazar Cheque">
                    <group>
                        <field name="cheque_id" readonly="1"/>
                        <field name="fecha"/>
                        <field name="motivo"/>
                    </group>
                    <footer>
                        <button name="action_confirmar" type="object" string="Confirmar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
