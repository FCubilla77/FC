<odoo>
    <data>
        <record id="view_local_py_orden_pago_form" model="ir.ui.view">
            <field name="name">local_py.orden_pago.form</field>
            <field name="model">local_py.orden_pago</field>
            <field name="arch" type="xml">
                <form string="Orden de Pago">
                    <header>
                        <button name="action_marcar_en_proceso" type="object" string="Marcar En Proceso"
                                class="btn-primary" invisible="state != 'borrador'"/>
                        <button name="%(local_py.action_report_orden_pago)d" type="action"
                                string="Descargar PDF" class="btn-secondary"/>
                        <button name="action_confirmar" type="object" string="Confirmar"
                                class="btn-primary" invisible="state != 'en_proceso'"
                                confirm="Esto genera un pago por cada Medio de Pago y concilia contra las facturas seleccionadas. ¿Confirma?"/>
                        <button name="action_volver_borrador" type="object" string="Volver a Borrador"
                                invisible="state != 'en_proceso'"/>
                        <button name="action_deshacer_confirmacion" type="object" string="Deshacer Confirmación"
                                invisible="state != 'confirmado'"
                                confirm="Esto cancela los pagos generados y deshace la conciliación contra las facturas. Si algún pago ya está conciliado con el banco, se bloqueará. ¿Confirma?"/>
                        <field name="state" widget="statusbar" statusbar_visible="borrador,en_proceso,confirmado"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"
                                       readonly="state != 'borrador'"/>
                                <field name="partner_id" options="{'no_create': True}"
                                       domain="[('supplier_rank', '>', 0)]" readonly="state != 'borrador'"/>
                                <field name="fecha" readonly="state != 'borrador'"/>
                                <field name="fecha_en_proceso" invisible="not fecha_en_proceso"/>
                                <field name="fecha_confirmacion" invisible="not fecha_confirmacion"/>
                                <field name="comentario" readonly="state != 'borrador'"/>
                            </group>
                            <group>
                                <field name="currency_id" options="{'no_create': True}" readonly="state != 'borrador'"/>
                                <field name="total_facturas"/>
                                <field name="total_medios"/>
                                <field name="diferencia"/>
                                <field name="total_retencion_iva_estimada"
                                       invisible="total_retencion_iva_estimada == 0"/>
                                <field name="total_retencion_renta_estimada"
                                       invisible="total_retencion_renta_estimada == 0"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Facturas" name="facturas">
                                <button name="action_cargar_facturas_pendientes" type="object"
                                        string="Cargar Facturas Pendientes" class="btn-secondary"
                                        invisible="state != 'borrador'"/>
                                <button name="action_actualizar_retencion_estimada" type="object"
                                        string="Actualizar Retención Estimada" class="btn-secondary"
                                        invisible="state not in ('borrador', 'en_proceso')"/>
                                <div class="alert alert-info" role="alert" invisible="not hay_monedas_distintas">
                                    Hay facturas en una moneda distinta a la de la cabecera. Al Confirmar,
                                    el sistema va a actualizar la Cotización y los valores convertidos con
                                    la tasa vigente en ese momento (salvo las que hayas corregido a mano).
                                </div>
                                <field name="factura_ids" readonly="state != 'borrador'">
                                    <list editable="bottom">
                                        <field name="move_id" readonly="1"/>
                                        <field name="nro_documento_factura" readonly="1"/>
                                        <field name="cuota" readonly="1"/>
                                        <field name="fecha_factura" readonly="1"/>
                                        <field name="fecha_vencimiento" readonly="1"/>
                                        <field name="currency_id" readonly="1"/>
                                        <field name="total_original" readonly="1"/>
                                        <field name="saldo_pendiente" readonly="1"/>
                                        <field name="importe_a_pagar" class="bg-success-subtle"/>
                                        <field name="cotizacion"/>
                                        <field name="valor_convertido" readonly="1"/>
                                        <field name="diferencia_cambio" readonly="1" optional="show"/>
                                        <field name="retencion_iva_estimada" readonly="1"
                                               class="bg-danger-subtle" optional="show"/>
                                        <field name="cotizacion_manual" column_invisible="1"/>
                                        <field name="header_currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Medios" name="medios">
                                <field name="medio_ids" readonly="state != 'borrador'">
                                    <list editable="bottom" decoration-info="es_retencion">
                                        <field name="journal_id"/>
                                        <field name="importe"/>
                                        <field name="fecha_emision"/>
                                        <field name="fecha_vencimiento"/>
                                        <field name="nro_documento"/>
                                        <field name="banco"/>
                                        <field name="chequera_id" readonly="1"/>
                                        <field name="cheque_reutilizar_id" options="{'no_create': True}"/>
                                        <field name="cuenta_banco"/>
                                        <field name="documentos_relacionados" readonly="1" string="Doc. relacionados"/>
                                        <field name="retencion_factura_id" readonly="1" optional="show"/>
                                        <field name="es_retencion" column_invisible="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="company_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Retenciones por Absorción al Exterior" name="retenciones_absorcion"
                                  invisible="not retencion_absorcion_ids">
                                <field name="retencion_absorcion_ids" readonly="1">
                                    <list>
                                        <field name="factura_id"/>
                                        <field name="concepto_iva_id"/>
                                        <field name="monto" string="IVA Retenido"/>
                                        <field name="absorcion_move_id_iva" string="Asiento Absorción IVA"/>
                                        <field name="concepto_renta_id"/>
                                        <field name="monto_renta" string="Renta Retenida"/>
                                        <field name="absorcion_move_id_renta" string="Asiento Absorción Renta"/>
                                        <field name="monto_total_gs" string="Total (Gs.)"/>
                                        <field name="estado" widget="badge"
                                               decoration-warning="estado == 'pendiente'"
                                               decoration-success="estado == 'levantada'"
                                               decoration-danger="estado == 'anulada'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_local_py_orden_pago_list" model="ir.ui.view">
            <field name="name">local_py.orden_pago.list</field>
            <field name="model">local_py.orden_pago</field>
            <field name="arch" type="xml">
                <list string="Órdenes de Pago">
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="partner_id"/>
                    <field name="total_medios"/>
                    <field name="currency_id"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'borrador'"
                           decoration-warning="state == 'en_proceso'"
                           decoration-success="state == 'confirmado'"/>
                </list>
            </field>
        </record>

        <record id="action_local_py_orden_pago" model="ir.actions.act_window">
            <field name="name">Orden de Pago</field>
            <field name="res_model">local_py.orden_pago</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_local_py_orden_pago"
                  name="Orden de Pago"
                  parent="account.menu_finance_payables"
                  action="action_local_py_orden_pago"
                  groups="account.group_account_manager"
                  sequence="15"/>
    </data>
</odoo>
