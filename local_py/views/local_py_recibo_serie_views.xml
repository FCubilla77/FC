<odoo>
    <data>
        <record id="view_local_py_recibo_serie_form" model="ir.ui.view">
            <field name="name">local_py.recibo.serie.form</field>
            <field name="model">local_py.recibo.serie</field>
            <field name="arch" type="xml">
                <form string="Serie de Recibo">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Ej: A"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                                <field name="user_id" options="{'no_create': True}"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="numero_inicial"/>
                                <field name="numero_final"/>
                                <field name="ultimo_numero_utilizado"/>
                                <field name="siguiente_numero"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_local_py_recibo_serie_list" model="ir.ui.view">
            <field name="name">local_py.recibo.serie.list</field>
            <field name="model">local_py.recibo.serie</field>
            <field name="arch" type="xml">
                <list string="Series de Recibo">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="user_id"/>
                    <field name="numero_inicial"/>
                    <field name="numero_final"/>
                    <field name="siguiente_numero"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_local_py_recibo_serie" model="ir.actions.act_window">
            <field name="name">Series de Recibo</field>
            <field name="res_model">local_py.recibo.serie</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_local_py_recibo_serie"
                  name="Series de Recibo"
                  parent="menu_local_py_datos_maestros"
                  action="action_local_py_recibo_serie"
                  groups="account.group_account_manager"
                  sequence="65"/>
    </data>
</odoo>
