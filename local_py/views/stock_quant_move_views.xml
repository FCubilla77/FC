<odoo>
    <data>
        <record id="view_stock_quant_tree_inventory_editable_l10n_py" model="ir.ui.view">
            <field name="name">stock.quant.tree.inventory.editable.l10n.py</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="l10n_py_asiento_ajuste_id" string="Asiento Contable"
                           optional="show" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_line_tree_l10n_py" model="ir.ui.view">
            <field name="name">stock.move.line.tree.l10n.py</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="l10n_py_asiento_ajuste_id" string="Asiento Contable"
                           optional="show" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
