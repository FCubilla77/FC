<odoo>
    <data>
        <record id="view_local_py_retencion_emitida_list" model="ir.ui.view">
            <field name="name">local_py.retencion_emitida.list</field>
            <field name="model">local_py.retencion_emitida</field>
            <field name="arch" type="xml">
                <list string="Retenciones Emitidas" decoration-muted="estado == 'anulada'" decoration-info="es_absorcion">
                    <field name="fecha"/>
                    <field name="partner_id"/>
                    <field name="factura_id"/>
                    <field name="orden_pago_id"/>
                    <field name="tipo_retencion"/>
                    <field name="base_5"/>
                    <field name="monto_5"/>
                    <field name="base_10"/>
                    <field name="monto_10"/>
                    <field name="porcentaje"/>
                    <field name="monto"/>
                    <field name="monto_gs"/>
                    <field name="concepto_iva_id"/>
                    <field name="numero_comprobante"/>
                    <field name="es_absorcion" string="Absorción"/>
                    <field name="estado" widget="badge"
                           decoration-warning="estado == 'pendiente'"
                           decoration-success="estado == 'levantada'"
                           decoration-danger="estado == 'anulada'"/>
                </list>
            </field>
        </record>

        <record id="view_local_py_retencion_emitida_form" model="ir.ui.view">
            <field name="name">local_py.retencion_emitida.form</field>
            <field name="model">local_py.retencion_emitida</field>
            <field name="arch" type="xml">
                <form string="Retención Emitida">
                    <header>
                        <button name="action_marcar_levantada" type="object" string="Marcar Levantada"
                                class="btn-primary" invisible="estado != 'pendiente'"/>
                        <button name="action_marcar_anulada" type="object" string="Anular"
                                class="btn-secondary" invisible="estado != 'levantada'"/>
                        <field name="estado" widget="statusbar" statusbar_visible="pendiente,levantada,anulada"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="orden_pago_id" readonly="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="factura_id" readonly="1"/>
                                <field name="fecha" readonly="1"/>
                                <field name="tipo_retencion" readonly="1"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="company_currency_id" invisible="1"/>
                                <field name="base_5" readonly="1"/>
                                <field name="monto_5" readonly="1"/>
                                <field name="base_10" readonly="1"/>
                                <field name="monto_10" readonly="1"/>
                                <field name="porcentaje" readonly="1"/>
                                <field name="monto" readonly="1"/>
                                <field name="monto_gs" readonly="1"/>
                                <field name="concepto_iva_id" readonly="1"/>
                                <field name="numero_comprobante" readonly="estado != 'pendiente'"/>
                                <field name="es_absorcion" readonly="1"/>
                                <field name="absorcion_move_id" readonly="1" invisible="not es_absorcion"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_local_py_retencion_emitida" model="ir.actions.act_window">
            <field name="name">Retenciones Emitidas</field>
            <field name="res_model">local_py.retencion_emitida</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_local_py_retencion_emitida"
                  name="Retenciones Emitidas"
                  parent="local_py.menu_l10n_py_localizacion"
                  action="action_local_py_retencion_emitida"
                  groups="account.group_account_manager"
                  sequence="15"/>
    </data>
</odoo>
