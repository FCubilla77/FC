<odoo>
    <data>
        <record id="view_local_py_configuracion_localizacion_form" model="ir.ui.view">
            <field name="name">local_py.configuracion_localizacion.form</field>
            <field name="model">local_py.configuracion_localizacion</field>
            <field name="arch" type="xml">
                <form string="Configuraciones Localización Py">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="create_uid" string="Usuario" readonly="1"/>
                            </group>
                            <group>
                                <field name="create_date" string="Fecha Creación" readonly="1"/>
                                <field name="write_date" string="Última modificación" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Renumeración de Asiento" name="renumeracion">
                                <field name="renumeracion_ids">
                                    <list editable="bottom">
                                        <field name="anio" string="Año"/>
                                        <field name="numero_inicial" string="Número Asiento Fiscal Inicial"/>
                                        <field name="ultimo_nro_utilizado" string="Ultimo Nro. Utilizado" readonly="1"/>
                                        <field name="ultima_fecha_procesada" string="Ultima fecha procesada" readonly="1"/>
                                        <button name="action_limpiar_numeracion" type="object" string="Limpiar"
                                                invisible="not ultima_fecha_procesada"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Imputación Tributaria" name="imputacion_tributaria">
                                <field name="l10n_py_imputacion_tributaria_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Detalle Libro Inventario" name="libro_inventario_detalle">
                                <field name="libro_inventario_detalle_ids">
                                    <list editable="bottom">
                                        <field name="account_id"/>
                                        <field name="criterio"/>
                                        <field name="nivel"/>
                                        <field name="cantidad_top" invisible="nivel != 'top_n'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Ajustes Generales" name="ajustes_generales">
                                <group string="Inventario">
                                    <field name="l10n_py_asiento_ajuste_inventario"/>
                                </group>
                            </page>
                            <page string="Orden de Pago / Recibos" name="retenciones">
                                <group string="Activación de Pagos">
                                    <field name="l10n_py_pagos_proveedores_activo"/>
                                    <field name="l10n_py_pagos_clientes_activo"/>
                                </group>
                                <group>
                                    <group string="Retención IVA">
                                        <field name="l10n_py_retencion_iva"/>
                                        <field name="l10n_py_retencion_iva_porcentaje"
                                               invisible="not l10n_py_retencion_iva"/>
                                        <field name="l10n_py_retencion_iva_minimo"
                                               invisible="not l10n_py_retencion_iva"/>
                                        <field name="l10n_py_diario_retencion_iva_id"
                                               invisible="not l10n_py_retencion_iva" options="{'no_create': True}"/>
                                        <field name="l10n_py_concepto_iva_id"
                                               invisible="not l10n_py_retencion_iva" options="{'no_create': True}"/>
                                        <field name="l10n_py_cuenta_gasto_absorcion_id"
                                               invisible="not l10n_py_retencion_iva" options="{'no_create': True}"/>
                                    </group>
                                    <group string="Retención Renta">
                                        <field name="l10n_py_retencion_renta"/>
                                        <field name="l10n_py_diario_retencion_renta_id"
                                               invisible="not l10n_py_retencion_renta" options="{'no_create': True}"/>
                                        <field name="l10n_py_cuenta_gasto_absorcion_renta_id"
                                               invisible="not l10n_py_retencion_renta" options="{'no_create': True}"/>
                                    </group>
                                </group>
                                <field name="company_currency_id" invisible="1"/>
                                <separator string="Resoluciones de No Retención"/>
                                <field name="no_retencion_ids">
                                    <list editable="bottom">
                                        <field name="partner_id" options="{'no_create': True}"/>
                                        <field name="tipo_retencion"/>
                                        <field name="fecha_desde"/>
                                        <field name="fecha_hasta"/>
                                        <field name="nro_resolucion"/>
                                    </list>
                                </field>
                                <separator string="Conceptos Renta No Residente"
                                           invisible="not l10n_py_retencion_renta"/>
                                <field name="concepto_renta_no_residente_ids"
                                       invisible="not l10n_py_retencion_renta">
                                    <list editable="bottom">
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="porcentaje_imputacion"/>
                                        <field name="porcentaje"/>
                                        <field name="porcentaje_absorcion"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_local_py_configuracion_localizacion_list" model="ir.ui.view">
            <field name="name">local_py.configuracion_localizacion.list</field>
            <field name="model">local_py.configuracion_localizacion</field>
            <field name="arch" type="xml">
                <list string="Configuraciones Localización Py">
                    <field name="company_id"/>
                    <field name="create_uid" string="Usuario"/>
                    <field name="create_date" string="Fecha Creación"/>
                    <field name="write_date" string="Última modificación"/>
                </list>
            </field>
        </record>

        <record id="action_local_py_configuracion_localizacion" model="ir.actions.act_window">
            <field name="name">Configuraciones Localización Py</field>
            <field name="res_model">local_py.configuracion_localizacion</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_local_py_configuracion_localizacion"
                  name="Configuraciones Localización Py"
                  parent="menu_local_py_configuraciones"
                  action="action_local_py_configuracion_localizacion"
                  groups="account.group_account_manager"
                  sequence="10"/>
    </data>
</odoo>
