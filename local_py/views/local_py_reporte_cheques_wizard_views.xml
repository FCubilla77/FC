<odoo>
    <data>
        <record id="view_local_py_reporte_cheques_wizard_form" model="ir.ui.view">
            <field name="name">local_py.reporte_cheques.wizard.form</field>
            <field name="model">local_py.reporte_cheques.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte de Cheques Emitidos">
                    <group>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="chequera_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button name="action_ver_reporte" type="object" string="Ver Reporte" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_local_py_reporte_cheques_wizard" model="ir.actions.act_window">
            <field name="name">Informe de Cheques</field>
            <field name="res_model">local_py.reporte_cheques.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_local_py_reporte_cheques"
                  name="Informe de Cheques"
                  parent="local_py.menu_local_py_reportes_localizacion"
                  action="action_local_py_reporte_cheques_wizard"
                  groups="account.group_account_manager"
                  sequence="75"/>
    </data>
</odoo>
