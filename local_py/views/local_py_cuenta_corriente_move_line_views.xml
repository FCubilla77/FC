<odoo>
    <data>
        <record id="view_local_py_cuenta_corriente_move_line_list" model="ir.ui.view">
            <field name="name">local_py.cuenta_corriente.move.line.list</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <list string="Cuenta Corriente" default_order="date, create_date">
                    <field name="date" string="Fecha"/>
                    <field name="create_date" string="Fecha de Creación"/>
                    <field name="journal_id" string="Diario"/>
                    <field name="move_id" string="Comprobante"/>
                    <field name="name" string="Comentario"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="company_id" column_invisible="1"/>
                    <field name="l10n_py_tipo_cliente_proveedor" column_invisible="1"/>
                    <field name="debit" string="Débito" sum="Total Débito"/>
                    <field name="credit" string="Crédito" sum="Total Crédito"/>
                </list>
            </field>
        </record>

        <record id="view_local_py_cuenta_corriente_move_line_search" model="ir.ui.view">
            <field name="name">local_py.cuenta_corriente.move.line.search</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <search string="Cuenta Corriente">
                    <field name="date" string="Fecha"/>
                    <field name="move_id"/>
                    <field name="journal_id"/>
                    <filter string="Fecha" name="filtro_fecha" date="date"/>
                    <separator/>
                    <filter string="Agrupar por Compañía" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Agrupar por Tipo" name="group_tipo"
                            context="{'group_by': 'l10n_py_tipo_cliente_proveedor'}"/>
                    <filter string="Agrupar por Moneda" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Agrupar por Diario" name="group_journal" context="{'group_by': 'journal_id'}"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
