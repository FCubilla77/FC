<odoo>
    <data>
        <template id="report_retenciones_listado_document">
            <t t-call="web.basic_layout">
                <style>.container { max-width: none !important; width: 100% !important; margin: 0 !important; padding: 0 !important; }</style>
                <div style="font-size: 9px; font-family: Arial, sans-serif; width: 100%;">
                    <table style="width: 100%; margin-bottom: 6px;">
                        <tr>
                            <td>
                                <strong t-esc="company.name"/><br/>
                                INFORME DE RETENCIONES<br/>
                                Fecha desde: <t t-esc="fecha_desde.strftime('%d/%m/%Y')"/>
                                al <t t-esc="fecha_hasta.strftime('%d/%m/%Y')"/>
                            </td>
                        </tr>
                    </table>
                    <table style="width: 100%; border-collapse: collapse;" border="1">
                        <colgroup>
                            <col style="width: 12%;"/>
                            <col style="width: 18%;"/>
                            <col style="width: 30%;"/>
                            <col style="width: 20%;"/>
                            <col style="width: 20%;"/>
                        </colgroup>
                        <thead>
                            <tr style="background-color: #eeeeee;">
                                <th style="padding: 3px;">Fecha</th>
                                <th style="padding: 3px;">Número</th>
                                <th style="padding: 3px;">Contacto</th>
                                <th style="padding: 3px;">Número de Factura</th>
                                <th align="right" style="padding: 3px; text-align: right;">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rows" t-as="fila">
                                <tr t-if="fila['tipo'] == 'moneda'" style="font-weight: bold; background-color: #dddddd;">
                                    <td colspan="5" style="padding: 3px;" t-esc="fila['moneda']"/>
                                </tr>
                                <tr t-elif="fila['tipo'] == 'familia'" style="font-weight: bold; background-color: #f0f0f0;">
                                    <td colspan="5" style="padding: 2px 2px 2px 12px;" t-esc="fila['familia']"/>
                                </tr>
                                <tr t-elif="fila['tipo'] == 'retencion'">
                                    <td style="padding: 2px 2px 2px 24px;" t-esc="fila['fecha'].strftime('%d/%m/%Y') if fila['fecha'] else ''"/>
                                    <td style="padding: 2px;" t-esc="fila['numero']"/>
                                    <td style="padding: 2px;" t-esc="fila['contacto']"/>
                                    <td style="padding: 2px;" t-esc="fila['nro_factura']"/>
                                    <td align="right" style="padding: 2px; text-align: right;" t-esc="fmt_moneda(fila['importe'], fila['moneda_obj'])"/>
                                </tr>
                                <tr t-elif="fila['tipo'] == 'subtotal_familia'" style="font-style: italic; border-top: 1px solid #999999;">
                                    <td colspan="4" style="padding: 2px;">Subtotal <t t-esc="fila['familia']"/></td>
                                    <td align="right" style="padding: 2px; text-align: right;" t-esc="fmt_moneda(fila['total'], fila['moneda_obj'])"/>
                                </tr>
                                <tr t-elif="fila['tipo'] == 'total_moneda'" style="font-weight: bold; background-color: #f0f0f0; border-top: 2px solid #000000;">
                                    <td colspan="4" style="padding: 2px;">Total <t t-esc="fila['moneda']"/></td>
                                    <td align="right" style="padding: 2px; text-align: right;" t-esc="fmt_moneda(fila['total'], fila['moneda_obj'])"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <record id="action_report_retenciones_listado" model="ir.actions.report">
            <field name="name">Informe de Retenciones</field>
            <field name="model">res.company</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">local_py.report_retenciones_listado_document</field>
            <field name="report_file">local_py.report_retenciones_listado_document</field>
            <field name="paperformat_id" ref="paperformat_stock_valorizado"/>
            <field name="binding_model_id" eval="False"/>
        </record>
    </data>
</odoo>
