<odoo>
    <data>
        <record id="view_local_py_documento_anulado_list" model="ir.ui.view">
            <field name="name">local_py.documento_anulado.list</field>
            <field name="model">local_py.documento_anulado</field>
            <field name="arch" type="xml">
                <list string="Documentos Anulados" editable="bottom">
                    <field name="diario_id"/>
                    <field name="timbrado"/>
                    <field name="numero"/>
                    <field name="tipo_fiscal_id"/>
                    <field name="motivo"/>
                    <field name="fecha_registro"/>
                    <field name="company_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_local_py_documento_anulado_form" model="ir.ui.view">
            <field name="name">local_py.documento_anulado.form</field>
            <field name="model">local_py.documento_anulado</field>
            <field name="arch" type="xml">
                <form string="Documento Anulado">
                    <sheet>
                        <group>
                            <group>
                                <field name="diario_id" options="{'no_create': True}"/>
                                <field name="timbrado"/>
                                <field name="numero"/>
                                <field name="tipo_fiscal_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="motivo"/>
                                <field name="fecha_registro"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_local_py_documento_anulado_search" model="ir.ui.view">
            <field name="name">local_py.documento_anulado.search</field>
            <field name="model">local_py.documento_anulado</field>
            <field name="arch" type="xml">
                <search string="Documentos Anulados">
                    <field name="diario_id"/>
                    <field name="numero"/>
                    <field name="tipo_fiscal_id"/>
                    <separator/>
                    <filter string="Diario" name="group_diario" context="{'group_by': 'diario_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_local_py_documento_anulado" model="ir.actions.act_window">
            <field name="name">Documentos Anulados</field>
            <field name="res_model">local_py.documento_anulado</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_diario': 1}</field>
        </record>

        <menuitem id="menu_local_py_documento_anulado"
                  name="Documentos Anulados"
                  parent="local_py.menu_l10n_py_localizacion"
                  action="action_local_py_documento_anulado"
                  groups="account.group_account_manager"
                  sequence="40"/>

        <record id="view_local_py_documento_anulado_rango_wizard_form" model="ir.ui.view">
            <field name="name">local_py.documento_anulado_rango_wizard.form</field>
            <field name="model">local_py.documento_anulado_rango_wizard</field>
            <field name="arch" type="xml">
                <form string="Registrar Documentos Anulados por Rango">
                    <group>
                        <field name="diario_id" options="{'no_create': True}"/>
                        <field name="numero_desde" placeholder="000-000-0000000"/>
                        <field name="numero_hasta" placeholder="000-000-0000000"/>
                        <field name="motivo"/>
                        <field name="fecha_registro"/>
                    </group>
                    <footer>
                        <button name="action_confirmar" type="object" string="Registrar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_local_py_documento_anulado_rango_wizard" model="ir.actions.act_window">
            <field name="name">Registrar Doc. Anulados por Rango</field>
            <field name="res_model">local_py.documento_anulado_rango_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_local_py_documento_anulado_rango"
                  name="Registrar Doc. Anulados por Rango"
                  parent="local_py.menu_l10n_py_localizacion"
                  action="action_local_py_documento_anulado_rango_wizard"
                  groups="account.group_account_manager"
                  sequence="41"/>
    </data>
</odoo>
