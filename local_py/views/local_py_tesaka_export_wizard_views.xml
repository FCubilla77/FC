<odoo>
    <data>
        <record id="view_local_py_tesaka_export_wizard_form" model="ir.ui.view">
            <field name="name">local_py.tesaka_export.wizard.form</field>
            <field name="model">local_py.tesaka_export.wizard</field>
            <field name="arch" type="xml">
                <form string="Generar Archivo Tesaka (Retenciones)">
                    <field name="attachment_id" invisible="1"/>
                    <group invisible="attachment_id">
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="incluir_ya_generadas"/>
                    </group>
                    <button name="action_cargar_retenciones_pendientes" type="object"
                            string="Cargar Retenciones Pendientes" class="btn-secondary"
                            invisible="attachment_id"/>
                    <field name="retencion_ids" invisible="attachment_id">
                        <list>
                            <field name="fecha"/>
                            <field name="partner_id"/>
                            <field name="factura_id"/>
                            <field name="orden_pago_id"/>
                            <field name="base_5"/>
                            <field name="monto_5"/>
                            <field name="base_10"/>
                            <field name="monto_10"/>
                            <field name="monto"/>
                            <field name="concepto_renta_id"/>
                            <field name="monto_renta"/>
                            <field name="estado"/>
                        </list>
                    </field>
                    <div class="alert alert-success" role="alert" invisible="not attachment_id">
                        Archivo generado: <field name="attachment_id" readonly="1" class="oe_inline"/>.
                        Descárguelo y ciérrese esta ventana cuando termine.
                    </div>
                    <footer>
                        <button name="action_generar_json" type="object" string="Generar Archivo JSON"
                                class="btn-primary" invisible="attachment_id"/>
                        <button name="action_descargar" type="object" string="Descargar"
                                class="btn-primary" invisible="not attachment_id"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" invisible="attachment_id"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel" invisible="not attachment_id"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_local_py_tesaka_export_wizard" model="ir.actions.act_window">
            <field name="name">Generar Archivo Tesaka</field>
            <field name="res_model">local_py.tesaka_export.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_local_py_tesaka_export"
                  name="Generar Archivo Tesaka"
                  parent="local_py.menu_local_py_retenciones"
                  action="action_local_py_tesaka_export_wizard"
                  groups="account.group_account_manager"
                  sequence="16"/>
    </data>
</odoo>
