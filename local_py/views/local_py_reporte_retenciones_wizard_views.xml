<odoo>
    <data>
        <record id="view_local_py_reporte_retenciones_wizard_form" model="ir.ui.view">
            <field name="name">local_py.reporte_retenciones.wizard.form</field>
            <field name="model">local_py.reporte_retenciones.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte de Retenciones">
                    <group>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Retenciones Emitidas">
                        <field name="incluir_emitidas"/>
                        <group invisible="not incluir_emitidas">
                            <field name="filtro_emitida_pendiente"/>
                            <field name="filtro_emitida_json_generado"/>
                            <field name="filtro_emitida_levantada"/>
                            <field name="filtro_emitida_anulada"/>
                        </group>
                    </group>
                    <group string="Retenciones Recibidas">
                        <field name="incluir_recibidas"/>
                        <group invisible="not incluir_recibidas">
                            <field name="filtro_recibida_a_confirmar"/>
                            <field name="filtro_recibida_confirmada"/>
                            <field name="filtro_recibida_anulada"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_ver_reporte" type="object" string="Ver Reporte" class="btn-primary"/>
                        <button name="action_descargar_pdf" type="object" string="Descargar PDF" class="btn-secondary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_local_py_reporte_retenciones_wizard" model="ir.actions.act_window">
            <field name="name">Informe de Retenciones</field>
            <field name="res_model">local_py.reporte_retenciones.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_local_py_reporte_retenciones"
                  name="Informe de Retenciones"
                  parent="local_py.menu_local_py_reportes_localizacion"
                  action="action_local_py_reporte_retenciones_wizard"
                  groups="account.group_account_manager"
                  sequence="72"/>
    </data>
</odoo>
