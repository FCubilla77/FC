<odoo>
    <data>
        <record id="view_local_py_orden_pago_saldo_favor_wizard_form" model="ir.ui.view">
            <field name="name">local_py.orden_pago.saldo_favor_wizard.form</field>
            <field name="model">local_py.orden_pago.saldo_favor_wizard</field>
            <field name="arch" type="xml">
                <form string="Sobra plata entre Medios y Facturas">
                    <p>
                        Los Medios de Pago cargados suman
                        <field name="diferencia" readonly="1" class="oe_inline"/>
                        más de lo que corresponde pagar de las Facturas seleccionadas.
                        ¿Qué querés hacer?
                    </p>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <field name="decision" widget="radio"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="decision != 'saldo_favor'">
                        El sobrante queda sin conciliar, disponible como Saldo a Favor en la
                        cuenta corriente del Proveedor — todavía no hay una forma de aplicarlo
                        automáticamente a una Orden de Pago futura (queda pendiente para una
                        próxima entrega). Mientras tanto, se puede aplicar a mano desde la
                        pantalla de conciliación de Contabilidad.
                    </div>
                    <field name="orden_pago_id" invisible="1"/>
                    <footer>
                        <button name="action_confirmar" type="object" string="Confirmar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
