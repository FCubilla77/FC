<odoo>
    <data>
        <record id="view_local_py_libro_wizard_form" model="ir.ui.view">
            <field name="name">local_py.libro.wizard.form</field>
            <field name="model">local_py.libro.wizard</field>
            <field name="arch" type="xml">
                <form string="Libro Diario / Libro Mayor">
                    <field name="tipo_libro" invisible="1"/>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                    </group>
                    <footer>
                        <button name="action_ver_reporte" type="object" string="Ver Reporte" class="btn-secondary"/>
                        <button name="action_descargar_pdf" type="object" string="Descargar PDF (Oficial)" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_move_line_list_libro_diario" model="ir.ui.view">
            <field name="name">account.move.line.list.libro.diario</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <list string="Libro Diario" create="false" edit="false"
                      default_order="date asc, move_id asc">
                    <field name="l10n_py_nro_asiento_libro" string="Nro. Asiento"/>
                    <field name="date" string="Fecha"/>
                    <field name="account_id" string="Cuenta"/>
                    <field name="name" string="Concepto"/>
                    <field name="l10n_py_comentario" string="Comentario"/>
                    <field name="debit" string="Débito" sum="Total Débito"/>
                    <field name="credit" string="Crédito" sum="Total Crédito"/>
                </list>
            </field>
        </record>

        <record id="view_move_line_list_libro_mayor" model="ir.ui.view">
            <field name="name">account.move.line.list.libro.mayor</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <list string="Libro Mayor" create="false" edit="false"
                      default_order="account_id asc, date asc, move_id asc">
                    <field name="account_id" string="Cuenta"/>
                    <field name="l10n_py_nro_asiento_libro" string="Nro. Asiento"/>
                    <field name="date" string="Fecha"/>
                    <field name="l10n_py_comentario" string="Comentario"/>
                    <field name="debit" string="Débito" sum="Total Débito"/>
                    <field name="credit" string="Crédito" sum="Total Crédito"/>
                </list>
            </field>
        </record>

        <record id="action_local_py_libro_diario_wizard" model="ir.actions.act_window">
            <field name="name">Libro Diario</field>
            <field name="res_model">local_py.libro.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_local_py_libro_wizard_form"/>
            <field name="target">new</field>
            <field name="context">{'default_tipo_libro': 'diario'}</field>
        </record>

        <record id="action_local_py_libro_mayor_wizard" model="ir.actions.act_window">
            <field name="name">Libro Mayor</field>
            <field name="res_model">local_py.libro.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_local_py_libro_wizard_form"/>
            <field name="target">new</field>
            <field name="context">{'default_tipo_libro': 'mayor'}</field>
        </record>

        <menuitem id="menu_local_py_reportes_localizacion"
                  name="Reportes Localización Py"
                  parent="account.menu_finance_reports"
                  sequence="40"/>

        <menuitem id="menu_local_py_libro_diario"
                  name="Libro Diario"
                  parent="menu_local_py_reportes_localizacion"
                  action="action_local_py_libro_diario_wizard"
                  groups="account.group_account_manager"
                  sequence="30"/>

        <menuitem id="menu_local_py_libro_mayor"
                  name="Libro Mayor"
                  parent="menu_local_py_reportes_localizacion"
                  action="action_local_py_libro_mayor_wizard"
                  groups="account.group_account_manager"
                  sequence="40"/>
    </data>
</odoo>
