<odoo>
    <data>
        <!--
            Requerimiento: los usuarios con "Contabilidad / Administrador"
            (account.group_account_manager) deben poder ver y editar, sin
            ajustes manuales adicionales, el plan de cuentas y los grupos
            de cuenta que este módulo instala (Contabilidad > Configuración
            > Plan de Cuentas / Grupos de Cuenta), además de las cuentas de
            ingreso/gasto en productos y categorías, y las cuentas por
            cobrar/pagar en clientes y proveedores.

            Las vistas nativas de Odoo restringen esos campos y menús con
            groups="account.group_account_readonly", un grupo que
            account.group_account_manager NO implica por sí solo en esta
            instalación.

            Se agrega aquí account.group_account_user ("Mostrar
            características de contabilidad completas") como implied_ids
            de account.group_account_manager. account.group_account_user ya
            implica tanto account.group_account_invoice como
            account.group_account_readonly, cubriendo así el requerimiento.

            IMPORTANTE: esta misma configuración también existe en el
            módulo local_py (data/account_groups_data.xml). Se duplica acá
            intencionalmente para que l10n_py sea autosuficiente y no
            dependa de que local_py esté instalado — no hay conflicto si
            ambos módulos están instalados juntos en la misma base, Odoo
            tolera bien que dos módulos agreguen el mismo implied_ids.
        -->
        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
    </data>
</odoo>
