<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Sección propia "Configuración l10n_py" en Ajustes (aparece como ítem
            propio en la barra lateral de Ajustes, por el name="l10n_py" del <app>,
            igual al nombre técnico del módulo). Aloja la licencia del producto:
            sin una licencia válida no se puede asignar el paquete fiscal Paraguay.
            Esta pantalla queda siempre disponible, con o sin licencia.
        -->
        <record id="res_config_settings_view_form_l10n_py" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.l10n_py</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="45"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Configuración l10n_py" string="Configuración l10n_py"
                         name="l10n_py" groups="account.group_account_manager">
                        <block title="Licencia" name="l10n_py_licencia">
                            <setting string="Código de la base"
                                     help="Versión del módulo e identificador único de esta base de datos. Envíeselo a FC_Py, tal cual, para que emita o renueve la licencia.">
                                <field name="l10n_py_licencia_uuid" readonly="1" widget="CopyClipboardChar"/>
                            </setting>
                            <setting string="Código de licencia"
                                     help="Pegue acá el código que le entregó FC_Py, tal cual lo recibió.">
                                <field name="l10n_py_licencia_codigo" nolabel="1"/>
                                <div class="content-group mt16">
                                    <div class="row mt4">
                                        <label for="l10n_py_licencia_estado" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_py_licencia_estado" widget="badge"
                                               decoration-success="l10n_py_licencia_estado == 'valida'"
                                               decoration-warning="l10n_py_licencia_estado == 'sin_licencia'"
                                               decoration-danger="l10n_py_licencia_estado in ('vencida', 'invalida', 'otra_version')"/>
                                    </div>
                                    <div class="row mt4" invisible="not l10n_py_licencia_cliente">
                                        <label for="l10n_py_licencia_cliente" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_py_licencia_cliente" readonly="1"/>
                                    </div>
                                    <div class="row mt4" invisible="not l10n_py_licencia_vencimiento">
                                        <label for="l10n_py_licencia_vencimiento" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_py_licencia_vencimiento" readonly="1"/>
                                    </div>
                                </div>
                                <div class="alert alert-success mt-2" role="alert"
                                     invisible="l10n_py_licencia_estado != 'valida'">
                                    Licencia vigente. Ya puede asignar el paquete fiscal «Paraguay» desde Ajustes &gt; Facturación &gt; Localización Fiscal.
                                </div>
                                <div class="alert alert-warning mt-2" role="alert"
                                     invisible="l10n_py_licencia_estado != 'otra_version'">
                                    Este código de licencia corresponde a otra versión del módulo. Después de actualizar a otra versión de Odoo hay que pedirle a FC_Py un código nuevo, usando el «Código de la base» actual.
                                </div>
                                <div class="alert alert-danger mt-2" role="alert"
                                     invisible="l10n_py_licencia_estado == 'valida'">
                                    Sin una licencia válida no se puede asignar el paquete fiscal Paraguay (plan de cuentas, grupos de cuentas, impuestos y configuración predeterminada), y se bloquea la creación y edición de Cierres de Ejercicio. Esta pantalla de Ajustes queda siempre disponible.
                                </div>
                            </setting>
                        </block>
                        <block title="Cierre de Ejercicio" name="l10n_py_cierre">
                            <setting string="Cuenta Resultado del Ejercicio"
                                     help="Cuenta de Patrimonio que recibe el resultado del año al ejecutar el Cierre de Ejercicio. Con el plan de cuentas Paraguay se asigna sola.">
                                <field name="l10n_py_cuenta_resultado_ejercicio_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </setting>
                        </block>
                        <block title="Plan de cuentas del cliente (Excel)" name="l10n_py_plantilla">
                            <setting string="Plan de cuentas a cargar"
                                     help="Qué se carga al seleccionar el paquete fiscal «Paraguay» en Ajustes > Facturación > Localización Fiscal. Solo se puede elegir antes de cargar el plan.">
                                <field name="l10n_py_plan_cargado" invisible="1"/>
                                <field name="l10n_py_modo_plan" widget="radio"
                                       readonly="l10n_py_plan_cargado"/>
                                <div class="text-muted mt8" invisible="not l10n_py_plan_cargado">
                                    El plan de cuentas ya está cargado. La plantilla del cliente solo sirve para la carga inicial.
                                </div>
                            </setting>
                            <setting string="Plantilla Excel del plan del cliente"
                                     help="Descargue la plantilla (viene con el plan estándar como ejemplo), complétela con el plan, los impuestos y las cuentas de su empresa, y cárguela para validarla."
                                     invisible="l10n_py_modo_plan != 'plantilla' or l10n_py_plan_cargado">
                                <div class="mt8">
                                    <button name="action_l10n_py_descargar_plantilla" type="object"
                                            string="Descargar plantilla Excel" icon="fa-download"
                                            class="btn-link"/>
                                </div>
                                <div class="mt8">
                                    <button name="action_l10n_py_abrir_carga_plantilla" type="object"
                                            string="Cargar y validar archivo" icon="fa-upload"
                                            class="btn-link"/>
                                </div>
                                <div class="content-group mt16" invisible="not l10n_py_plantilla_estado">
                                    <div class="row mt4">
                                        <label for="l10n_py_plantilla_archivo" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_py_plantilla_archivo" readonly="1"/>
                                    </div>
                                    <div class="row mt4">
                                        <label for="l10n_py_plantilla_estado" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_py_plantilla_estado" widget="badge" readonly="1"
                                               decoration-success="l10n_py_plantilla_estado in ('validada', 'cargada')"
                                               decoration-danger="l10n_py_plantilla_estado == 'error'"/>
                                    </div>
                                    <field name="l10n_py_plantilla_log" readonly="1" nolabel="1" class="mt8"/>
                                </div>
                                <div class="alert alert-info mt-2" role="alert"
                                     invisible="l10n_py_plantilla_estado != 'validada'">
                                    Plantilla validada. Ahora seleccione el paquete «Paraguay» en Ajustes &gt; Facturación &gt; Localización Fiscal para cargarla.
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
