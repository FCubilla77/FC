<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_l10n_py_plan_cuentas_report_list" model="ir.ui.view">
            <field name="name">l10n_py.plan_cuentas.report.list</field>
            <field name="model">l10n_py.plan_cuentas.report</field>
            <field name="arch" type="xml">
                <list string="Plan de Cuentas" create="false" edit="false" delete="false"
                      decoration-bf="tipo == 'title'">
                    <header>
                        <button name="action_manual_refresh" type="object" string="Actualizar" class="btn-secondary"/>
                    </header>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="tipo"/>
                    <field name="nivel"/>
                    <field name="account_type"/>
                    <field name="raiz_id" optional="show"/>
                    <field name="group_name" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                    <button name="action_open_account" type="object" string="Abrir cuenta"
                            icon="fa-external-link" invisible="tipo != 'imputable'"/>
                </list>
            </field>
        </record>

        <record id="view_l10n_py_plan_cuentas_report_search" model="ir.ui.view">
            <field name="name">l10n_py.plan_cuentas.report.search</field>
            <field name="model">l10n_py.plan_cuentas.report</field>
            <field name="arch" type="xml">
                <search string="Buscar en Plan de Cuentas">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="raiz_id"/>
                    <filter string="Títulos" name="filter_title" domain="[('tipo', '=', 'title')]"/>
                    <filter string="Imputables" name="filter_imputable" domain="[('tipo', '=', 'imputable')]"/>
                    <separator/>
                    <filter string="Grupo raíz" name="group_raiz" context="{'group_by': 'raiz_id'}"/>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo'}"/>
                </search>
            </field>
        </record>

        <!-- El menú abre una acción de servidor que primero reconstruye el
             listado con los datos actuales y luego lo muestra. -->
        <record id="action_l10n_py_plan_cuentas_report" model="ir.actions.server">
            <field name="name">Plan de Cuentas</field>
            <field name="model_id" ref="model_l10n_py_plan_cuentas_report"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_report()</field>
        </record>

        <menuitem id="menu_l10n_py_plan_cuentas_report"
                  name="Plan de Cuentas"
                  parent="account.menu_finance_reports"
                  action="action_l10n_py_plan_cuentas_report"
                  sequence="15"/>

        <!-- Cada usuario ve solo las filas de sus compañías activas. -->
        <record id="rule_l10n_py_plan_cuentas_report_company" model="ir.rule">
            <field name="name">Plan de Cuentas (Paraguay): multi-compañía</field>
            <field name="model_id" ref="model_l10n_py_plan_cuentas_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

    </data>
</odoo>
