<odoo>
    <data noupdate="1">
        <record id="ir_cron_fe_py_reintentar_documentos" model="ir.cron">
            <field name="name">FE_Py: Reintentar Documentos Electrónicos pendientes</field>
            <field name="model_id" ref="model_fe_py_documento_electronico"/>
            <field name="state">code</field>
            <field name="code">model._cron_reintentar_pendientes()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_fe_py_reintentar_eventos" model="ir.cron">
            <field name="name">FE_Py: Reintentar Eventos SIFEN pendientes</field>
            <field name="model_id" ref="model_fe_py_evento"/>
            <field name="state">code</field>
            <field name="code">model._cron_reintentar_pendientes()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
