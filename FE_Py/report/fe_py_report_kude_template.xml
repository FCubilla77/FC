<odoo>
    <template id="report_kude_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size:11px;">

                        <!-- Encabezado: Emisor + Datos de Timbrado -->
                        <table style="width:100%; border-bottom:2px solid #000; padding-bottom:6px; margin-bottom:8px;">
                            <tr>
                                <td style="width:58%; vertical-align:top;">
                                    <div style="font-size:14px; font-weight:bold;" t-esc="doc.move_id.company_id.name"/>
                                    <div>RUC: <span t-esc="doc.move_id.company_id.vat"/></div>
                                    <div t-esc="doc.move_id.company_id.street"/>
                                    <div>
                                        <span t-if="doc.move_id.company_id.city_id" t-esc="doc.move_id.company_id.city_id.name"/><span t-if="doc.move_id.company_id.city_id and doc.move_id.company_id.state_id">, </span>
                                        <span t-if="doc.move_id.company_id.state_id" t-esc="doc.move_id.company_id.state_id.name"/>
                                    </div>
                                    <div t-if="doc.move_id.company_id.phone">Tel.: <span t-esc="doc.move_id.company_id.phone"/></div>
                                    <div t-if="doc.move_id.company_id.email">Email: <span t-esc="doc.move_id.company_id.email"/></div>
                                </td>
                                <td style="width:42%; vertical-align:top; border:1px solid #000; padding:6px;">
                                    <div style="text-align:center; font-weight:bold;">DOCUMENTO ELECTRÓNICO</div>
                                    <div style="text-align:center; font-weight:bold;" t-esc="doc.tipo_fiscal_id.name"/>
                                    <div>Timbrado N°: <span t-esc="'%08d' % (doc.move_id.l10n_py_timbrado or 0)"/></div>
                                    <div>N° Documento: <span t-esc="doc.move_id.l10n_py_nro_documento"/></div>
                                    <div>Fecha Emisión: <span t-esc="doc.move_id.invoice_date"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- CDC -->
                        <div style="border:1px solid #000; padding:5px; margin-bottom:8px; word-break:break-all; text-align:center;">
                            <strong>CDC: </strong><span t-esc="doc.cdc"/>
                        </div>

                        <!-- Receptor + Condicion -->
                        <table style="width:100%; margin-bottom:8px;">
                            <tr>
                                <td style="width:60%; vertical-align:top;">
                                    <strong>Cliente:</strong> <span t-esc="doc.partner_id.name"/><br/>
                                    <strong>RUC/Doc.:</strong> <span t-esc="doc.partner_id.vat"/><br/>
                                    <strong>Dirección:</strong> <span t-esc="doc.partner_id.street"/>
                                </td>
                                <td style="width:40%; vertical-align:top;">
                                    <strong>Condición de Venta:</strong>
                                    <span t-esc="'Crédito' if doc.move_id.invoice_payment_term_id.l10n_py_condicion == 'credito' else 'Contado'"/>
                                    <br/>
                                    <strong>Moneda:</strong> <span t-esc="doc.move_id.currency_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Items -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                            <thead>
                                <tr style="border-top:1px solid #000; border-bottom:1px solid #000;">
                                    <th style="text-align:left; padding:3px;">Código</th>
                                    <th style="text-align:left; padding:3px;">Descripción</th>
                                    <th style="text-align:right; padding:3px;">Cant.</th>
                                    <th style="text-align:right; padding:3px;">P. Unit.</th>
                                    <th style="text-align:right; padding:3px;">Desc.</th>
                                    <th style="text-align:right; padding:3px;">IVA</th>
                                    <th style="text-align:right; padding:3px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.move_id.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line"
                                    style="border-bottom:1px solid #ddd;">
                                    <td style="padding:3px;" t-esc="line.product_id.default_code or ''"/>
                                    <td style="padding:3px;" t-esc="line.name"/>
                                    <td style="text-align:right; padding:3px;" t-esc="'%.2f' % line.quantity"/>
                                    <td style="text-align:right; padding:3px;" t-esc="'{:,.0f}'.format(line.price_unit)"/>
                                    <td style="text-align:right; padding:3px;" t-esc="'%.0f%%' % (line.discount or 0)"/>
                                    <td style="text-align:right; padding:3px;" t-esc="', '.join(line.tax_ids.mapped('name')) or 'Exento'"/>
                                    <td style="text-align:right; padding:3px;" t-esc="'{:,.0f}'.format(line.price_total)"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Totales -->
                        <table style="width:100%; margin-bottom:12px;">
                            <tr>
                                <td style="width:60%;"/>
                                <td style="width:40%;">
                                    <table style="width:100%;">
                                        <tr>
                                            <td>Total Gravado 10%:</td>
                                            <td style="text-align:right;" t-esc="'{:,.0f}'.format(doc.move_id._l10n_py_mkt_montos_por_tasa()['10'])"/>
                                        </tr>
                                        <tr>
                                            <td>Total Gravado 5%:</td>
                                            <td style="text-align:right;" t-esc="'{:,.0f}'.format(doc.move_id._l10n_py_mkt_montos_por_tasa()['5'])"/>
                                        </tr>
                                        <tr>
                                            <td>Total Exento:</td>
                                            <td style="text-align:right;" t-esc="'{:,.0f}'.format(doc.move_id._l10n_py_mkt_montos_por_tasa()['exento'])"/>
                                        </tr>
                                        <tr style="font-weight:bold; border-top:1px solid #000;">
                                            <td>Total a Pagar (Gs.):</td>
                                            <td style="text-align:right;" t-esc="'{:,.0f}'.format(doc.move_id.amount_total)"/>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- QR + textos legales -->
                        <table style="width:100%; border-top:1px solid #000; padding-top:8px;">
                            <tr>
                                <td style="width:25%; text-align:center; vertical-align:top;">
                                    <img t-if="doc.qr_image" t-att-src="'data:image/png;base64,%s' % doc.qr_image.decode('utf-8')"
                                         style="width:90px; height:90px;"/>
                                </td>
                                <td style="width:75%; font-size:8px; vertical-align:top; padding-left:8px;">
                                    <p>Consulte la validez de este Documento Electrónico con el número de CDC
                                       en: <span t-esc="doc.qr_url"/></p>
                                    <p>Este documento es una representación gráfica (KuDE) de un Documento
                                       Electrónico, generado a partir del XML autorizado por la DNIT a
                                       través del SIFEN.</p>
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_kude" model="ir.actions.report">
        <field name="name">KuDE</field>
        <field name="model">fe_py.documento_electronico</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fe_py.report_kude_document</field>
        <field name="report_file">fe_py.report_kude_document</field>
        <field name="paperformat_id" ref="paperformat_fe_py_kude"/>
        <field name="print_report_name">'KuDE_%s' % (object.cdc or object.id)</field>
        <field name="binding_model_id" ref="model_fe_py_documento_electronico"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
