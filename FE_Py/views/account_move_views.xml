<odoo>
    <data>
        <!-- Tipo de Operación en la cabecera del comprobante -->
        <record id="view_move_form_fe_py_cabecera" model="ir.ui.view">
            <field name="name">account.move.form.fe.py.cabecera</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_date" position="after">
                    <field name="fe_py_es_electronico" invisible="1"/>
                    <field name="fe_py_es_nc_nd" invisible="1"/>
                    <field name="fe_py_tipo_operacion_id"
                           invisible="move_type not in ('out_invoice', 'out_refund') or not fe_py_es_electronico"/>
                </field>
            </field>
        </record>

        <!-- Pestaña completa de Facturación Electrónica -->
        <record id="view_move_form_fe_py" model="ir.ui.view">
            <field name="name">account.move.form.fe.py</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Facturación Electrónica" name="fe_py_tab"
                          invisible="move_type not in ('out_invoice', 'out_refund') or not fe_py_es_electronico">

                        <group>
                            <group string="Datos de la Operación">
                                <field name="fe_py_indicador_presencia_id"/>
                                <field name="fe_py_tipo_impuesto_id"/>
                                <field name="fe_py_motivo_emision_id" invisible="not fe_py_es_nc_nd"/>
                                <field name="fe_py_cdc_comprobante_asociado" invisible="not reversed_entry_id"/>
                            </group>
                            <group string="Condición del Crédito">
                                <field name="fe_py_condicion_credito"/>
                            </group>
                        </group>

                        <group string="Compras Públicas" invisible="not fe_py_es_b2g">
                            <field name="fe_py_venta_directa"/>
                            <group invisible="fe_py_venta_directa">
                                <field name="fe_py_dmodcont" placeholder="LP, CD, LC..."/>
                                <field name="fe_py_dentcont"/>
                                <field name="fe_py_danocont"/>
                            </group>
                            <group invisible="fe_py_venta_directa">
                                <field name="fe_py_dseccont"/>
                                <field name="fe_py_dfecodcont"/>
                                <field name="fe_py_dcodcondncp"/>
                            </group>
                        </group>

                        <field name="fe_py_cuota_ids" invisible="fe_py_condicion_credito != '2'">
                            <list editable="bottom">
                                <field name="fecha_vencimiento"/>
                                <field name="monto"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>

                        <group string="Estado en SIFEN">
                            <group>
                                <field name="fe_py_estado" widget="badge"
                                       decoration-success="fe_py_estado in ('aprobado', 'aprobado_observacion')"
                                       decoration-danger="fe_py_estado in ('rechazado', 'error_comunicacion')"
                                       decoration-info="fe_py_estado in ('borrador', 'xml_generado', 'firmado', 'enviado')"
                                       decoration-muted="fe_py_estado in ('cancelado', 'inutilizado')"/>
                                <field name="fe_py_cdc"/>
                                <field name="fe_py_codigo_respuesta"/>
                                <field name="fe_py_protocolo_autorizacion"/>
                            </group>
                            <group>
                                <field name="fe_py_fecha_envio"/>
                                <field name="fe_py_fecha_respuesta"/>
                                <field name="fe_py_intentos"/>
                                <field name="fe_py_simulado"/>
                                <field name="fe_py_email_enviado"/>
                            </group>
                        </group>
                        <field name="fe_py_mensaje_respuesta" placeholder="Mensaje de respuesta de SIFEN..." readonly="1"/>

                        <group string="Simulador SIFEN" colspan="2" invisible="fe_py_ambiente != 'simulado'">
                            <group>
                                <field name="fe_py_simular_resultado"/>
                            </group>
                            <group>
                                <field name="fe_py_simular_codigo_rechazo"/>
                                <field name="fe_py_simular_mensaje_rechazo"/>
                            </group>
                        </group>

                        <div class="mb-3 mt-2">
                            <button name="fe_py_action_generar_xml" type="object"
                                    string="Generar / Regenerar XML" class="btn-secondary"
                                    invisible="fe_py_envio_automatico"/>
                            <button name="fe_py_action_firmar" type="object"
                                    string="Firmar" class="btn-secondary"
                                    invisible="fe_py_envio_automatico"/>
                            <button name="fe_py_action_enviar" type="object"
                                    string="Enviar" class="btn-secondary"
                                    invisible="fe_py_envio_automatico"/>
                            <button name="fe_py_action_reenviar" type="object"
                                    string="Reescribir XML y Reenviar" class="btn-primary"
                                    invisible="fe_py_envio_automatico and fe_py_estado not in ('rechazado', 'error_comunicacion')"/>
                            <button name="fe_py_action_generar_kude" type="object"
                                    string="Generar KuDE" class="btn-secondary"
                                    invisible="fe_py_kude_automatico"/>
                            <button name="fe_py_action_enviar_email" type="object"
                                    string="Enviar Email al Cliente" class="btn-secondary"
                                    invisible="fe_py_email_automatico"/>
                        </div>

                        <notebook>
                            <page string="XML Generado">
                                <field name="fe_py_xml_generado" widget="text" readonly="1"/>
                            </page>
                            <page string="XML Firmado">
                                <field name="fe_py_xml_firmado" widget="text" readonly="1"/>
                            </page>
                            <page string="XML Final (documento fiscal)">
                                <field name="fe_py_xml_final" widget="text" readonly="1"/>
                            </page>
                            <page string="Respuesta SIFEN">
                                <field name="fe_py_respuesta_sifen_raw" widget="text" readonly="1"/>
                            </page>
                            <page string="KuDE">
                                <field name="fe_py_kude_pdf" filename="fe_py_kude_pdf_filename" readonly="1"/>
                                <field name="fe_py_kude_pdf_filename" invisible="1"/>
                            </page>
                            <page string="Historial de Envíos, Respuestas y Estados">
                                <field name="fe_py_log_ids" readonly="1">
                                    <list>
                                        <field name="fecha"/>
                                        <field name="tipo_operacion"/>
                                        <field name="resultado"
                                               decoration-success="resultado == 'exito'"
                                               decoration-danger="resultado == 'error'"
                                               decoration-warning="resultado == 'advertencia'"/>
                                        <field name="codigo_resultado"/>
                                        <field name="mensaje_resultado"/>
                                        <field name="usuario_id"/>
                                        <field name="simulado"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
