<odoo>
    <data>
        <record id="view_fe_py_configuracion_form" model="ir.ui.view">
            <field name="name">fe_py.configuracion.form</field>
            <field name="model">fe_py.configuracion</field>
            <field name="arch" type="xml">
                <form string="Configuraciones Generales FEPy">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="habilitado"/>
                            </group>
                            <group>
                                <field name="ambiente"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Datos del Emisor" name="emisor">
                                <group>
                                    <group>
                                        <field name="tipo_contribuyente"/>
                                        <field name="tipo_regimen_id" options="{'no_create': True}"/>
                                    </group>
                                </group>
                                <separator string="Actividades Económicas"/>
                                <div class="text-muted mb-2">
                                    Deben coincidir exactamente con las actividades registradas
                                    ante la DNIT. Se informan todas en el XML.
                                </div>
                                <field name="actividad_economica_ids" widget="many2many">
                                    <list editable="bottom">
                                        <field name="codigo"/>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Certificado Digital" name="certificado">
                                <group>
                                    <group>
                                        <field name="certificado_file"
                                               filename="certificado_filename"/>
                                        <field name="certificado_filename" invisible="1"/>
                                        <field name="certificado_password" password="True"/>
                                    </group>
                                    <group>
                                        <field name="certificado_vencimiento"/>
                                    </group>
                                </group>
                                <button name="fe_py_generar_certificados" type="object"
                                        string="Generar Certificados" class="btn-primary"/>
                                <group string="Rutas generadas en el servidor">
                                    <field name="cert_path"/>
                                    <field name="private_key_path"/>
                                    <field name="public_key_path"/>
                                </group>
                                <div class="text-muted">
                                    La Clave Privada nunca se guarda en la base de datos:
                                    queda como archivo en el servidor, con permisos restringidos.
                                </div>
                            </page>

                            <page string="Código de Seguridad (CSC)" name="csc">
                                <group>
                                    <field name="idcsc"/>
                                    <field name="csc"/>
                                </group>
                                <div class="text-muted">
                                    Los valores que vienen cargados son los genéricos que la DNIT
                                    publica para el Ambiente de Test. Antes de pasar a Producción
                                    hay que reemplazarlos por los propios.
                                </div>
                            </page>

                            <page string="Automatización" name="automatizacion">
                                <group>
                                    <field name="envio_automatico"/>
                                    <field name="kude_automatico"/>
                                    <field name="email_automatico"/>
                                    <field name="reintento_automatico"/>
                                </group>
                                <div class="text-muted">
                                    El reintento automático corre cada 30 minutos por defecto.
                                    El intervalo se cambia en Ajustes &gt; Técnico &gt;
                                    Acciones Planificadas.
                                </div>
                            </page>

                            <page string="Valores por Defecto" name="defaults">
                                <group>
                                    <group>
                                        <field name="sistema_facturacion_id" options="{'no_create': True}"/>
                                        <field name="tipo_emision_id" options="{'no_create': True}"/>
                                        <field name="condicion_tipo_cambio_id" options="{'no_create': True}"/>
                                    </group>
                                    <group>
                                        <field name="tipo_documento_asociado_id" options="{'no_create': True}"/>
                                        <field name="unidad_medida_id" options="{'no_create': True}"/>
                                    </group>
                                </group>
                                <div class="text-muted">
                                    La Unidad de Medida por Defecto se usa solo en las líneas de
                                    factura cargadas a mano, sin producto.
                                </div>
                            </page>

                            <page string="Sistema de Facturación" name="sistema_facturacion_ids">
                                <field name="sistema_facturacion_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipos de Emisión" name="tipo_emision_ids">
                                <field name="tipo_emision_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipos de Régimen" name="tipo_regimen_ids">
                                <field name="tipo_regimen_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipos de Operación" name="tipo_operacion_ids">
                                <field name="tipo_operacion_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="es_b2g"/>
                                        <field name="es_b2f"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipos de Transacción" name="tipo_transaccion_ids">
                                <field name="tipo_transaccion_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="tipo_producto"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipos de Impuesto" name="tipo_impuesto_ids">
                                <field name="tipo_impuesto_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Indicadores de Presencia" name="indicador_presencia_ids">
                                <field name="indicador_presencia_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Motivos de Emisión" name="motivo_emision_ids">
                                <field name="motivo_emision_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Documento Asociado" name="tipo_documento_asociado_ids">
                                <field name="tipo_documento_asociado_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipo de Contribuyente" name="tipo_contribuyente_ids">
                                <field name="tipo_contribuyente_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Condición Tipo de Cambio" name="condicion_tipo_cambio_ids">
                                <field name="condicion_tipo_cambio_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Afectación IVA" name="afectacion_iva_ids">
                                <field name="afectacion_iva_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name"/>
                                        <field name="proporcion_gravada"/>
                                        <field name="disponible"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Unidades de Medida" name="unidad_medida_ids">
                                <field name="unidad_medida_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="codigo"/>
                                        <field name="name" string="Representación (va al XML)"/>
                                        <field name="descripcion_larga"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Servicios de SIFEN" name="urls">
                                <group>
                                    <group string="Ambiente de Test">
                                        <field name="ws_recibe_test"/>
                                        <field name="ws_evento_test"/>
                                        <field name="qr_test"/>
                                        <field name="consulta_test"/>
                                    </group>
                                    <group string="Ambiente de Producción">
                                        <field name="ws_recibe_prod"/>
                                        <field name="ws_evento_prod"/>
                                        <field name="qr_prod"/>
                                        <field name="consulta_prod"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="timeout"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_fe_py_configuracion_list" model="ir.ui.view">
            <field name="name">fe_py.configuracion.list</field>
            <field name="model">fe_py.configuracion</field>
            <field name="arch" type="xml">
                <list string="Configuraciones Generales FEPy">
                    <field name="company_id"/>
                    <field name="ambiente"/>
                    <field name="habilitado"/>
                    <field name="certificado_vencimiento"/>
                </list>
            </field>
        </record>

        <record id="action_fe_py_configuracion" model="ir.actions.act_window">
            <field name="name">Configuraciones Generales FEPy</field>
            <field name="res_model">fe_py.configuracion</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_fe_py_configuracion"
                  name="Configuraciones Generales FEPy"
                  parent="menu_fe_py_grupo"
                  action="action_fe_py_configuracion"
                  groups="account.group_account_manager"
                  sequence="8"/>
    </data>
</odoo>
