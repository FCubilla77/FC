<odoo>
    <data>
        <record id="view_fe_py_tipo_fiscal_form" model="ir.ui.view">
            <field name="name">local_py.tipo_fiscal.form.fe_py</field>
            <field name="model">local_py.tipo_fiscal</field>
            <field name="inherit_id" ref="local_py.view_local_py_tipo_fiscal_form"/>
            <field name="arch" type="xml">
                <field name="sequence" position="after">
                    <field name="fe_py_es_electronico"/>
                    <field name="fe_py_itide" invisible="not fe_py_es_electronico"/>
                    <field name="fe_py_itide_descripcion" invisible="not fe_py_es_electronico"/>
                </field>
            </field>
        </record>

        <record id="view_fe_py_tipo_fiscal_list" model="ir.ui.view">
            <field name="name">local_py.tipo_fiscal.list.fe_py</field>
            <field name="model">local_py.tipo_fiscal</field>
            <field name="inherit_id" ref="local_py.view_local_py_tipo_fiscal_list"/>
            <field name="arch" type="xml">
                <field name="active" position="before">
                    <field name="fe_py_es_electronico" optional="show"/>
                    <field name="fe_py_itide" optional="show"/>
                    <field name="fe_py_itide_descripcion" optional="hide"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
