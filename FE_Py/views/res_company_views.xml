<odoo>
    <data>
        <record id="view_company_form_fe_py" model="ir.ui.view">
            <field name="name">res.company.form.fe.py</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="Facturación Electrónica (SIFEN)">
                        <group>
                            <field name="fe_py_ambiente"/>
                            <field name="fe_py_habilitado"/>
                        </group>
                        <group>
                            <field name="fe_py_idcsc"/>
                            <field name="fe_py_csc"/>
                        </group>
                        <group string="Automatización" colspan="2">
                            <group>
                                <field name="fe_py_envio_automatico"/>
                            </group>
                            <group>
                                <field name="fe_py_kude_automatico"/>
                                <field name="fe_py_email_automatico"/>
                            </group>
                        </group>
                        <group string="Datos del Emisor (para el XML del DE)" colspan="2">
                            <field name="fe_py_tipo_contribuyente"/>
                            <field name="fe_py_tipo_regimen"/>
                            <field name="fe_py_actividad_economica_codigo"/>
                            <field name="fe_py_actividad_economica_desc"/>
                        </group>
                        <group string="Certificado Digital" colspan="2">
                            <field name="fe_py_certificado_filename" invisible="1"/>
                            <field name="fe_py_certificado_file"
                                   filename="fe_py_certificado_filename"/>
                            <field name="fe_py_certificado_password" password="True"/>
                            <button name="fe_py_generar_certificados" type="object"
                                    string="Generar Certificados" class="btn-secondary"
                                    colspan="2"/>
                            <field name="fe_py_cert_path" readonly="1"/>
                            <field name="fe_py_private_key_path" readonly="1"/>
                            <field name="fe_py_certificado_vencimiento" readonly="1"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
