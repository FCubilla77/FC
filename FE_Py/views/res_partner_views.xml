<odoo>
    <data>
        <record id="view_partner_form_fe_py" model="ir.ui.view">
            <field name="name">res.partner.form.fe_py</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Facturación Electrónica" name="fe_py_tab">
                        <group>
                            <group string="Identificación ante SIFEN">
                                <field name="fe_py_tipo_contribuyente_id" options="{'no_create': True}"/>
                                <field name="fe_py_identificacion_texto"
                                       placeholder="CUIT, RFC, NIT, Tax ID..."/>
                                <field name="fe_py_es_exterior" readonly="1"/>
                                <field name="fe_py_es_contribuyente" readonly="1"/>
                                <field name="fe_py_es_estado"/>
                            </group>
                            <group string="Valores por defecto de la operación">
                                <field name="fe_py_tipo_impuesto_id"/>
                                <field name="fe_py_indicador_presencia_id"/>
                            </group>
                        </group>
                        <div class="text-muted">
                            Estos valores se proponen automáticamente en cada Factura
                            de este Cliente y quedan editables por operación.
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
