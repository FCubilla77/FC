<odoo>
    <data>
        <record id="view_fe_py_log_list" model="ir.ui.view">
            <field name="name">fe_py.documento_electronico.log.list</field>
            <field name="model">fe_py.documento_electronico.log</field>
            <field name="arch" type="xml">
                <list string="Log de Operaciones Electrónicas" default_order="fecha desc"
                      create="false" edit="false" delete="false">
                    <field name="fecha"/>
                    <field name="move_id"/>
                    <field name="partner_id"/>
                    <field name="journal_id" optional="hide"/>
                    <field name="tipo_operacion"/>
                    <field name="resultado" widget="badge"
                           decoration-success="resultado == 'exito'"
                           decoration-danger="resultado == 'error'"
                           decoration-warning="resultado == 'advertencia'"/>
                    <field name="codigo_resultado"/>
                    <field name="mensaje_resultado"/>
                    <field name="usuario_id" optional="hide"/>
                    <field name="simulado" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <button name="action_ver_operacion" type="object"
                            string="Ver" icon="fa-external-link" title="Ver la operación (comprobante o evento)"/>
                </list>
            </field>
        </record>

        <record id="view_fe_py_log_form" model="ir.ui.view">
            <field name="name">fe_py.documento_electronico.log.form</field>
            <field name="model">fe_py.documento_electronico.log</field>
            <field name="arch" type="xml">
                <form string="Operación Electrónica" create="false" edit="false" delete="false">
                    <header>
                        <button name="action_ver_operacion" type="object"
                                string="Ver Operación" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="fecha"/>
                                <field name="move_id"/>
                                <field name="journal_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="tipo_operacion"/>
                                <field name="resultado"/>
                                <field name="codigo_resultado"/>
                                <field name="usuario_id"/>
                                <field name="simulado"/>
                            </group>
                        </group>
                        <field name="mensaje_resultado"/>
                        <notebook>
                            <page string="Request">
                                <field name="request_payload" widget="text"/>
                            </page>
                            <page string="Response">
                                <field name="response_payload" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_fe_py_log_search" model="ir.ui.view">
            <field name="name">fe_py.documento_electronico.log.search</field>
            <field name="model">fe_py.documento_electronico.log</field>
            <field name="arch" type="xml">
                <search string="Buscar en el Log de Operaciones Electrónicas">
                    <field name="move_id"/>
                    <field name="partner_id"/>
                    <field name="mensaje_resultado"/>
                    <field name="codigo_resultado"/>
                    <separator/>
                    <filter string="Éxito" name="filter_exito" domain="[('resultado', '=', 'exito')]"/>
                    <filter string="Error" name="filter_error" domain="[('resultado', '=', 'error')]"/>
                    <filter string="Advertencia" name="filter_advertencia" domain="[('resultado', '=', 'advertencia')]"/>
                    <separator/>
                    <filter string="Simulado" name="filter_simulado" domain="[('simulado', '=', True)]"/>
                    <separator/>
                    <filter string="Hoy" name="filter_hoy"
                            domain="[('fecha', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Esta semana" name="filter_semana"
                            domain="[('fecha', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <separator/>
                    <separator string="Agrupar por"/>
                    <group>
                        <filter string="Tipo de Operación" name="group_tipo_operacion" context="{'group_by': 'tipo_operacion'}"/>
                        <filter string="Resultado" name="group_resultado" context="{'group_by': 'resultado'}"/>
                        <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Diario" name="group_journal" context="{'group_by': 'journal_id'}"/>
                        <filter string="Fecha" name="group_fecha" context="{'group_by': 'fecha:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_fe_py_log" model="ir.actions.act_window">
            <field name="name">Log de Operaciones Electrónicas</field>
            <field name="res_model">fe_py.documento_electronico.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_fe_py_log_search"/>
        </record>

        <menuitem id="menu_fe_py_log"
                  name="Log de Operaciones Electrónicas"
                  action="action_fe_py_log"
                  parent="menu_fe_py_grupo"
                  sequence="50"/>
    </data>
</odoo>
