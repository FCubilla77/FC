<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fe_py_recepcion" model="ir.ui.view">
        <field name="name">account.move.form.fe.py.recepcion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Los campos de CDC los declara local_py (>= 2026.19.017); este módulo solo los carga.
                 Si la factura vino de una recepción, el CDC queda bloqueado. -->
            <field name="l10n_py_cdc" position="attributes">
                <attribute name="readonly">fe_py_recepcion_count > 0 or state != 'draft'</attribute>
            </field>
            <field name="l10n_py_cdc_asociado" position="attributes">
                <attribute name="readonly">fe_py_recepcion_count > 0 or state != 'draft'</attribute>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="fe_py_recepcion_count" invisible="1"/>
                <button name="action_ver_fe_py_recepcion" type="object" class="oe_stat_button"
                        icon="fa-file-code-o" invisible="fe_py_recepcion_count == 0"
                        groups="account.group_account_readonly">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Factura electrónica recibida</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
