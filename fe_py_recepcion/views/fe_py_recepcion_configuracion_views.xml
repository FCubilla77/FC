<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fe_py_recepcion_configuracion_form" model="ir.ui.view">
        <field name="name">fe_py_recepcion.configuracion.form</field>
        <field name="model">fe_py_recepcion.configuracion</field>
        <field name="arch" type="xml">
            <form string="Configuración de recepción de facturas electrónicas">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="diario_id"/>
                        </group>
                        <group string="Impuestos de compra (con IVA incluido en el precio)">
                            <field name="impuesto_iva10_id"/>
                            <field name="impuesto_iva5_id"/>
                            <field name="impuesto_exento_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fe_py_recepcion_configuracion_list" model="ir.ui.view">
        <field name="name">fe_py_recepcion.configuracion.list</field>
        <field name="model">fe_py_recepcion.configuracion</field>
        <field name="arch" type="xml">
            <list string="Configuración de recepción">
                <field name="company_id"/>
                <field name="diario_id"/>
                <field name="impuesto_iva10_id"/>
                <field name="impuesto_iva5_id"/>
                <field name="impuesto_exento_id"/>
            </list>
        </field>
    </record>

    <record id="action_fe_py_recepcion_configuracion" model="ir.actions.act_window">
        <field name="name">Recepción de Facturas Electrónicas</field>
        <field name="res_model">fe_py_recepcion.configuracion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
