<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fe_py_recepcion_documento_form" model="ir.ui.view">
        <field name="name">fe_py_recepcion.documento.form</field>
        <field name="model">fe_py_recepcion.documento</field>
        <field name="arch" type="xml">
            <form string="Factura electrónica recibida">
                <header>
                    <button name="action_verificar" type="object" string="Verificar" class="btn-primary"
                            invisible="state != 'cargado'" groups="account.group_account_invoice"/>
                    <button name="action_confirmar" type="object" string="Confirmar" class="btn-primary"
                            invisible="state != 'verificado'" groups="account.group_account_manager"
                            confirm="Se generará la factura de proveedor. Quedará publicada si la compañía deja las facturas leídas en Confirmado y el proveedor tiene la confirmación automática; si no, en borrador. ¿Continuar?"/>
                    <button name="action_reprocesar" type="object" string="Reprocesar"
                            invisible="state not in ('cargado', 'verificado')"
                            groups="account.group_account_invoice"/>
                    <button name="action_reprocesar" type="object" string="Reprocesar"
                            invisible="state != 'borrador'" groups="account.group_account_invoice"
                            confirm="Se eliminará la factura en borrador y se generará de nuevo con la configuración actual. Los cambios hechos a mano en ese borrador se perderán. ¿Continuar?"/>
                    <button name="action_confirmar_productos" type="object" string="Confirmar productos"
                            invisible="state not in ('cargado', 'verificado', 'borrador') or not hay_productos_sugeridos"
                            groups="account.group_account_invoice"/>
                    <button name="action_controlar" type="object" string="Controlar totales"
                            invisible="state != 'cargado'" groups="account.group_account_invoice"/>
                    <button name="action_buscar_proveedor" type="object" string="Buscar proveedor"
                            invisible="state != 'cargado' or partner_id" groups="account.group_account_invoice"/>
                    <button name="action_crear_proveedor" type="object" string="Crear proveedor"
                            invisible="state != 'cargado' or partner_id" groups="account.group_account_invoice"/>
                    <button name="action_volver_cargado" type="object" string="Volver a Cargado"
                            invisible="state != 'verificado'" groups="account.group_account_invoice"/>
                    <button name="action_cancelar" type="object" string="Cancelar"
                            invisible="state not in ('cargado', 'verificado')"
                            groups="account.group_account_invoice"/>
                    <button name="action_reabrir" type="object" string="Reabrir"
                            invisible="state != 'cancelado'" groups="account.group_account_invoice"/>
                    <button name="action_reintentar" type="object" string="Reintentar lectura" class="btn-primary"
                            invisible="state != 'error' or not xml_attachment_id"
                            groups="account.group_account_invoice"/>
                    <button name="action_descartar" type="object" string="Descartar"
                            invisible="state != 'error'" groups="account.group_account_invoice"
                            confirm="El registro pasará a Cancelado. ¿Continuar?"/>
                    <button name="action_ver_xml" type="object" string="Descargar XML"
                            invisible="not xml_attachment_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="cargado,verificado,borrador,confirmado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_factura" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Factura</span>
                                <span class="o_stat_value"><field name="move_state"/></span>
                            </div>
                        </button>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not hay_bloqueos or state in ('borrador', 'confirmado', 'cancelado', 'na')">
                        <strong>Impedimentos para continuar</strong>
                        <field name="bloqueos" class="d-block"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not avisos or state in ('confirmado', 'cancelado', 'na')">
                        <strong>Avisos</strong>
                        <field name="avisos" class="d-block"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>No se pudo cargar</strong>
                        <field name="error_detalle" class="d-block"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not confirmacion_auto_motivo or state not in ('cargado', 'verificado', 'borrador')">
                        <strong>Pendiente de revisión</strong>
                        <field name="confirmacion_auto_motivo" class="d-block"/>
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="state != 'na'">
                        <strong>No corresponde cargarlo (N/A)</strong>
                        <field name="na_motivo" class="d-block"/>
                        <field name="documento_original_id" invisible="not documento_original_id"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="xml_attachment_id" invisible="1"/>
                    <group>
                        <group string="Documento del proveedor">
                            <field name="origen"/>
                            <field name="correo_remitente" invisible="origen != 'correo'"/>
                            <field name="correo_asunto" invisible="origen != 'correo'"/>
                            <field name="correo_fecha" invisible="origen != 'correo'"/>
                            <field name="itide" invisible="not itide"/>
                            <field name="nro_documento"/>
                            <field name="timbrado"/>
                            <field name="fecha_emision"/>
                            <field name="cdc"/>
                            <field name="moneda_codigo"/>
                            <field name="tipo_cambio" invisible="not tipo_cambio"/>
                            <field name="motivo_desc" invisible="not motivo_desc"/>
                            <field name="asociado_texto" invisible="not asociado_texto"/>
                            <field name="cdc_asociado" invisible="not cdc_asociado"/>
                        </group>
                        <group string="Factura de proveedor a generar">
                            <field name="emisor_ruc"/>
                            <field name="partner_id" readonly="state != 'cargado'"/>
                            <field name="journal_id" readonly="state != 'cargado'"/>
                            <field name="payment_term_id" readonly="state != 'cargado'"/>
                            <field name="condicion_detalle"/>
                            <field name="reversed_move_id" readonly="state != 'cargado'"
                                   invisible="itide != '5'"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                    </group>
                    <notebook invisible="state in ('error', 'na')">
                        <page string="Líneas" name="lineas">
                            <field name="line_ids" readonly="state != 'cargado'">
                                <list string="Líneas" editable="bottom" create="0" delete="0">
                                    <field name="orden" optional="show"/>
                                    <field name="codigo" optional="show"/>
                                    <field name="descripcion"/>
                                    <field name="producto_id" readonly="state != 'cargado'"
                                           options="{'no_create': True}"/>
                                    <field name="producto_origen" optional="show"/>
                                    <field name="cuenta_id" readonly="state != 'cargado'"
                                           options="{'no_create': True}" optional="show"/>
                                    <field name="unidad_desc" optional="show"/>
                                    <field name="unidad_codigo" optional="hide"/>
                                    <field name="gtin" optional="hide"/>
                                    <field name="gtin_paquete" optional="hide"/>
                                    <field name="lote" optional="hide"/>
                                    <field name="vencimiento_lote" optional="hide"/>
                                    <field name="serie" optional="hide"/>
                                    <field name="info_item" optional="hide"/>
                                    <field name="cantidad"/>
                                    <field name="precio_xml" optional="hide"/>
                                    <field name="precio"/>
                                    <field name="descuento"/>
                                    <field name="afectacion_texto" optional="show"/>
                                    <field name="impuesto_id" readonly="state != 'cargado'"
                                           options="{'no_create': True}"/>
                                    <field name="total_xml" sum="Total"/>
                                    <field name="aviso" optional="hide"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="subtotal_10"/>
                                <field name="subtotal_5"/>
                                <field name="subtotal_exento"/>
                                <field name="total_iva"/>
                                <field name="total_general" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Cuotas del XML" name="cuotas" invisible="not cuota_ids">
                            <p class="text-muted">
                                Son de referencia. Odoo calcula las cuotas y vencimientos de la
                                factura con el término de pago elegido.
                            </p>
                            <field name="cuota_ids">
                                <list>
                                    <field name="numero"/>
                                    <field name="monto"/>
                                    <field name="vencimiento"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <field name="entrega_inicial" invisible="not entrega_inicial"/>
                            </group>
                        </page>
                        <page string="Proveedor y receptor" name="partes">
                            <group>
                                <group string="Emisor (proveedor)">
                                    <field name="emisor_nombre"/>
                                    <field name="emisor_fantasia"/>
                                    <field name="emisor_direccion"/>
                                    <field name="emisor_ciudad"/>
                                    <field name="emisor_telefono"/>
                                    <field name="emisor_email"/>
                                </group>
                                <group string="Receptor">
                                    <field name="receptor_ruc"/>
                                    <field name="receptor_nombre"/>
                                </group>
                            </group>
                        </page>
                        <page string="Datos adicionales del XML" name="datos_adicionales">
                            <p class="text-muted">
                                Datos que informó el proveedor y que no intervienen en la factura
                                generada. Se guardan solo para consulta.
                            </p>
                            <group>
                                <group string="Documento">
                                    <field name="xml_version"/>
                                    <field name="emision_xml"/>
                                    <field name="timbrado_inicio"/>
                                    <field name="emisor_tipo_contribuyente"/>
                                    <field name="motivo_codigo" invisible="not motivo_codigo"/>
                                </group>
                                <group string="Condición de crédito" invisible="condicion != '2'">
                                    <field name="credito_tipo"/>
                                    <field name="credito_plazo" invisible="not credito_plazo"/>
                                    <field name="credito_cuotas" invisible="not credito_cuotas"/>
                                </group>
                                <group string="Totales informados">
                                    <field name="subtotal_exonerado"/>
                                    <field name="descuento_total"/>
                                    <field name="descuento_global"/>
                                    <field name="anticipo"/>
                                    <field name="redondeo"/>
                                    <field name="total_gs"/>
                                </group>
                                <group string="Documento asociado" invisible="not asociado_tipo">
                                    <field name="asociado_tipo"/>
                                    <field name="asociado_timbrado" invisible="not asociado_timbrado"/>
                                    <field name="asociado_establecimiento" invisible="not asociado_establecimiento"/>
                                    <field name="asociado_punto" invisible="not asociado_punto"/>
                                    <field name="asociado_numero" invisible="not asociado_numero"/>
                                    <field name="asociado_fecha" invisible="not asociado_fecha"/>
                                </group>
                            </group>
                        </page>
                        <page string="Control de totales" name="control">
                            <group>
                                <group string="Según el XML">
                                    <field name="total_general"/>
                                    <field name="total_iva"/>
                                </group>
                                <group string="Calculado por Odoo">
                                    <field name="total_odoo"/>
                                    <field name="iva_odoo"/>
                                    <field name="control_hecho"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fe_py_recepcion_documento_list" model="ir.ui.view">
        <field name="name">fe_py_recepcion.documento.list</field>
        <field name="model">fe_py_recepcion.documento</field>
        <field name="arch" type="xml">
            <list string="Facturas electrónicas recibidas"
                  decoration-muted="state in ('cancelado', 'na')" decoration-success="state == 'confirmado'"
                  decoration-info="state == 'verificado'" decoration-warning="state == 'borrador'"
                  decoration-danger="state == 'error'">
                <header>
                    <button name="%(action_fe_py_recepcion_cargar_wizard)d" type="action" string="Cargar XML"
                            display="always" class="btn-primary" groups="account.group_account_invoice"/>
                    <button name="action_reprocesar" type="object" string="Reprocesar"
                            groups="account.group_account_invoice"/>
                    <button name="action_volver_cargado" type="object" string="Volver a Cargado"
                            groups="account.group_account_invoice"/>
                </header>
                <field name="fecha_emision"/>
                <field name="nro_documento"/>
                <field name="itide"/>
                <field name="emisor_ruc"/>
                <field name="emisor_nombre"/>
                <field name="partner_id" optional="show"/>
                <field name="total_general" sum="Total"/>
                <field name="currency_id" optional="show"/>
                <field name="move_id" optional="show"/>
                <field name="origen" optional="show"/>
                <field name="correo_remitente" optional="hide"/>
                <field name="correo_asunto" optional="hide"/>
                <field name="error_detalle" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmado'" decoration-info="state == 'verificado'"
                       decoration-warning="state == 'borrador'"
                       decoration-muted="state in ('cancelado', 'na')" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_fe_py_recepcion_documento_search" model="ir.ui.view">
        <field name="name">fe_py_recepcion.documento.search</field>
        <field name="model">fe_py_recepcion.documento</field>
        <field name="arch" type="xml">
            <search string="Facturas electrónicas recibidas">
                <field name="name" string="Documento"
                       filter_domain="['|', '|', ('nro_documento', 'ilike', self), ('emisor_nombre', 'ilike', self), ('cdc', 'ilike', self)]"/>
                <field name="emisor_ruc"/>
                <field name="partner_id"/>
                <field name="cdc"/>
                <field name="correo_remitente"/>
                <field name="correo_asunto"/>
                <filter name="filtro_cargado" string="Cargadas" domain="[('state', '=', 'cargado')]"/>
                <filter name="filtro_verificado" string="Verificadas" domain="[('state', '=', 'verificado')]"/>
                <filter name="filtro_borrador" string="Con factura en borrador" domain="[('state', '=', 'borrador')]"/>
                <filter name="filtro_confirmado" string="Confirmadas (publicadas)" domain="[('state', '=', 'confirmado')]"/>
                <filter name="filtro_cancelado" string="Canceladas" domain="[('state', '=', 'cancelado')]"/>
                <filter name="filtro_error" string="Con error" domain="[('state', '=', 'error')]"/>
                <filter name="filtro_na" string="N/A" domain="[('state', '=', 'na')]"/>
                <separator/>
                <filter name="filtro_no_publicados" string="No publicados"
                        domain="[('state', 'in', ('cargado', 'verificado', 'borrador'))]"/>
                <filter name="filtro_pendientes" string="Pendientes de revisar"
                        domain="[('state', 'in', ('cargado', 'verificado', 'borrador', 'error'))]"/>
                <separator/>
                <filter name="filtro_correo" string="Recibidas por correo" domain="[('origen', '=', 'correo')]"/>
                <separator/>
                <filter name="filtro_sin_proveedor" string="Sin proveedor" domain="[('partner_id', '=', False)]"/>
                <group>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_origen" string="Origen" context="{'group_by': 'origen'}"/>
                    <filter name="group_proveedor" string="Proveedor" context="{'group_by': 'emisor_nombre'}"/>
                    <filter name="group_tipo" string="Tipo de documento" context="{'group_by': 'itide'}"/>
                    <filter name="group_mes" string="Mes de emisión" context="{'group_by': 'fecha_emision:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fe_py_recepcion_documento" model="ir.actions.act_window">
        <field name="name">Facturas Electrónicas Recibidas</field>
        <field name="res_model">fe_py_recepcion.documento</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filtro_pendientes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay facturas electrónicas recibidas</p>
            <p>Use "Cargar XML" para cargar los archivos que le enviaron sus proveedores.</p>
        </field>
    </record>
</odoo>
