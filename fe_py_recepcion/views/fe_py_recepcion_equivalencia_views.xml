<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fe_py_recepcion_equivalencia_list" model="ir.ui.view">
        <field name="name">fe_py_recepcion.equivalencia.list</field>
        <field name="model">fe_py_recepcion.equivalencia</field>
        <field name="arch" type="xml">
            <list string="Equivalencias de productos" editable="bottom">
                <field name="partner_id"/>
                <field name="codigo"/>
                <field name="descripcion"/>
                <field name="producto_id"/>
                <field name="producto_referencia"/>
                <field name="ultimo_uso" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fe_py_recepcion_equivalencia_search" model="ir.ui.view">
        <field name="name">fe_py_recepcion.equivalencia.search</field>
        <field name="model">fe_py_recepcion.equivalencia</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="codigo"/>
                <field name="descripcion"/>
                <field name="producto_id"/>
                <field name="producto_referencia"/>
                <group>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fe_py_recepcion_equivalencia" model="ir.actions.act_window">
        <field name="name">Equivalencias de Productos</field>
        <field name="res_model">fe_py_recepcion.equivalencia</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
